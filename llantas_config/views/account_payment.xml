<odoo>
    <data>
        <record id="form_view_account_payment_inherit" model="ir.ui.view">
            <field name="name">Account_payment_inherit</field>
            <field name="model">account.payment</field>
             <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form//sheet//group//group[@name='group1']//field[@name='memo']" position="after">
                    <field name="to_check"/>
                    <field name="l10n_mx_edi_payment_method_id"/>
                </xpath>
            
            </field>
        </record>

        <record id="list_view_account_payment_inherit" model="ir.ui.view">
            <field name="name">list_account_payment</field>
            <field name="model">account.payment</field>
             <field name="inherit_id" ref="account.view_account_payment_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list//field[@name='journal_id']" position="after">
                    <field name="to_check"/>
                </xpath>
            </field>
        </record>
        
        <record id="search_view_account_payment_inherit" model="ir.ui.view">
            <field name="name">search_account_payment</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_search"/>
            <field name="arch" type="xml">
                <xpath expr="//search//filter[@name='reconciled']" position="after">
                    <filter string="Revisados" name="to_check" domain="[('to_check', '=', True)]"/>
                    <filter string="Por revisar" name="to_check" domain="[('to_check', '=', False)]"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
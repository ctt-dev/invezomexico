<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================================================== -->
    <!-- PURCHASE STOCK -->
    <!-- ====================================================== -->
    <template id="purchase_stock_report_purchaseorder_document_for_llantas"
              inherit_id="purchase_stock.report_purchaseorder_document">
        <xpath expr="//t[@t-else='']" position="replace">
            <!-- Vacío intencional -->
        </xpath>
    </template>

    <!-- ====================================================== -->
    <!-- PURCHASE ORDER -->
    <!-- ====================================================== -->
    <template id="purchase_report_purchaseorder_document_for_llantas"
              inherit_id="purchase.report_purchaseorder_document" priority="99">

        <!-- ====================================================== -->
        <!-- HEADER - Reemplazar todo el bloque de información -->
        <!-- ====================================================== -->
        <xpath expr="//div[@id='informations']" position="replace">

            <!-- Nota importante -->
            <div class="mt-3 mb-3" style="background-color: #e8f5e9; border-left: 4px solid #73A07B; padding: 10px;">
                <strong>⚠️ NOTA IMPORTANTE</strong><br/>
                Este número de Orden de Compra debe aparecer en toda factura, guía, remisión o correspondencia.
            </div>

            <!-- Fechas -->
            <div class="row mb-3">
                <div class="col-3" t-if="o.user_id">
                    <strong>Pedido por:</strong>
                    <div><span t-field="o.user_id"/></div>
                </div>
                <div class="col-3" t-if="o.partner_ref">
                    <strong>Ref. Compra:</strong>
                    <div><span t-field="o.partner_ref"/></div>
                </div>
                <div class="col-3" t-if="o.date_approve">
                    <strong>Fecha Orden:</strong>
                    <div><span t-field="o.date_approve" t-options="{'date_only': 'true'}"/></div>
                </div>
                <div class="col-3" t-if="o.date_planned">
                    <strong>Llegada Esperada:</strong>
                    <div><span t-field="o.date_planned" t-options="{'date_only': 'true'}"/></div>
                </div>
            </div>

        </xpath>

        <!-- ====================================================== -->
        <!-- TABLA DE PRODUCTOS - TODAS LAS COLUMNAS CON MISMO COLOR -->
        <!-- ====================================================== -->
        
        <!-- Estilo de la tabla -->
        <xpath expr="//table[1]" position="attributes">
            <attribute name="style">font-size: 10pt; width: 100%; margin-top: 20px; margin-bottom: 20px;</attribute>
        </xpath>

        <!-- Eliminar cabecera original de cantidad -->
        <xpath expr="//th[@name='th_quantity']" position="replace"/>

        <!-- Modificar cabecera de Descripción con el mismo color -->
        <xpath expr="//th[@name='th_description']" position="attributes">
            <attribute name="style">background-color: #73A07B; color: white; padding: 8px;</attribute>
            <attribute name="class">text-start</attribute>
        </xpath>

        <!-- Modificar cabecera de Descuento -->
        <xpath expr="//th[@name='th_discount']" position="attributes">
            <attribute name="style">background-color: #73A07B; color: white; padding: 8px;</attribute>
            <attribute name="class">text-end</attribute>
        </xpath>

        <!-- Modificar cabecera de Impuestos -->
        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="style">background-color: #73A07B; color: white; padding: 8px;</attribute>
            <attribute name="class">text-end</attribute>
        </xpath>

        <!-- Nuevas cabeceras (Cantidad, Unidad, Código, Código Proveedor) -->
        <xpath expr="//th[@name='th_description']" position="before">
            <th class="text-center" style="background-color: #73A07B; color: white; padding: 8px;">Cant.</th>
            <th class="text-center" style="background-color: #73A07B; color: white; padding: 8px;">Unidad</th>
            <th class="text-center" style="background-color: #73A07B; color: white; padding: 8px;">Código</th>
            <th class="text-center" style="background-color: #73A07B; color: white; padding: 8px;">Código Proveedor</th>
        </xpath>

        <!-- Precio Unitario -->
        <xpath expr="//th[@name='th_price_unit']" position="replace">
            <th name="th_price_unit" class="text-center" style="background-color: #73A07B; color: white; padding: 8px;">Precio Unitario</th>
        </xpath>

        <!-- Subtotal -->
        <xpath expr="//th[@name='th_subtotal']" position="replace">
            <th name="th_subtotal" class="text-center" style="background-color: #73A07B; color: white; padding: 8px;">Monto</th>
        </xpath>

        <!-- ====================================================== -->
        <!-- CELDAS DE LA TABLA -->
        <!-- ====================================================== -->

        <!-- Eliminar celda original de cantidad -->
        <xpath expr="//td[span[@t-field='line.product_qty']]" position="replace"/>

        <!-- Nuevas celdas -->
        <xpath expr="//td[@id='product']" position="before">
            <td class="text-center"><strong><span t-field="line.product_qty"/></strong></td>
            <td class="text-center"><span t-field="line.product_uom_id.name" groups="uom.group_uom"/></td>
            <td class="text-center"><span t-field="line.product_id.default_code"/></td>
            <td class="text-center"><span t-field="line.codigo_proveedor"/></td>
        </xpath>

        <!-- ====================================================== -->
        <!-- MONTO EN LETRA DESPUÉS DE TOTALES -->
        <!-- ====================================================== -->
        
        <xpath expr="//div[@id='total']" position="after">
            
            <!-- Monto en letra -->
            <div class="mt-3" style="background-color: #fff3cd; border-left: 4px solid #ffc107; padding: 10px;">
                <strong>💰 IMPORTE CON LETRA</strong><br/>
                <span style="text-transform: uppercase;">
                    <t t-esc="o.currency_id.with_context(lang=o.partner_id.lang or 'es_ES').amount_to_text(o.amount_total)"/>
                </span>
            </div>

        </xpath>

        <!-- ====================================================== -->
        <!-- OBSERVACIONES - MODIFICAR LA EXISTENTE -->
        <!-- ====================================================== -->
        
        <xpath expr="//p[@t-field='o.note']" position="replace">
            <div class="mt-3" style="background-color: #d1ecf1; border-left: 4px solid #17a2b8; padding: 10px;" t-if="o.note">
                <strong>📌 OBSERVACIONES</strong><br/>
                <span t-field="o.note"/>
            </div>
        </xpath>

    </template>

</odoo>
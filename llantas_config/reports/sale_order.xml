<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="sale_order_report_document_for_llantas"
              inherit_id="sale.report_saleorder_document"
              priority="99">

        <!-- ===================================================== -->
        <!-- ESTILOS -->
        <!-- ===================================================== -->

        <xpath expr="//div[@class='page']"
               position="before">

            <style>

                .llantas_table{
                    font-size: 8pt !important;
                }

                .llantas_table thead tr{
                    background-color: #73A07B !important;
                    color: white !important;
                }

                .llantas_table th{
                    padding: 4px !important;
                }

                .llantas_table td{
                    padding: 3px !important;
                    vertical-align: middle !important;
                }

            </style>

        </xpath>

        <!-- ===================================================== -->
        <!-- INFORMACIÓN -->
        <!-- ===================================================== -->

        <xpath expr="//div[@id='informations']"
               position="replace">

            <div class="row mb-3"
                 id="informations"
                 style="font-size: 8pt;">

                <div class="col-4"
                     t-if="doc.folio_venta">

                    <strong>No. Venta</strong>

                    <div t-field="doc.folio_venta"/>

                </div>

                <div class="col-4"
                     t-if="doc.client_order_ref">

                    <strong>Su Referencia</strong>

                    <div t-field="doc.client_order_ref"/>

                </div>

                <div class="col-4">

                    <strong t-if="doc.state in ['draft','sent']">
                        Fecha Cotización
                    </strong>

                    <strong t-else="">
                        Fecha Orden
                    </strong>

                    <div t-field="doc.date_order"
                         t-options='{"widget":"date"}'/>

                </div>

                <div class="col-4 mt-2"
                     t-if="doc.validity_date and doc.state in ['draft','sent']">

                    <strong>Vencimiento</strong>

                    <div t-field="doc.validity_date"/>

                </div>

                <div class="col-4 mt-2"
                     t-if="doc.user_id">

                    <strong>Vendedor</strong>

                    <div t-field="doc.user_id"/>

                </div>

            </div>

        </xpath>

        <!-- ===================================================== -->
        <!-- CLASE A TABLA -->
        <!-- ===================================================== -->

        <xpath expr="//table[contains(@class,'o_main_table')]"
               position="attributes">

            <attribute name="class">
                o_has_total_table table o_main_table table-borderless llantas_table
            </attribute>

        </xpath>

        <!-- ===================================================== -->
        <!-- HEADERS -->
        <!-- ===================================================== -->

        <xpath expr="//th[@name='th_description']"
               position="replace">

            <th name="th_description"
                class="text-start">

                Descripción

            </th>

        </xpath>

        <xpath expr="//th[@name='th_quantity']"
               position="replace">

            <th name="th_quantity"
                class="text-end text-nowrap">

                Cant.

            </th>

        </xpath>

        <xpath expr="//th[@name='th_priceunit']"
               position="replace">

            <th name="th_priceunit"
                class="text-end text-nowrap">

                Precio SIN IVA

            </th>

        </xpath>

        <xpath expr="//th[@name='th_discount']"
               position="replace">

            <th name="th_discount"
                t-if="display_discount"
                class="text-end">

                Desc. %

            </th>

        </xpath>

        <xpath expr="//th[@name='th_subtotal']"
               position="replace">

            <th name="th_subtotal"
                class="text-end">

                Importe

            </th>

        </xpath>

        <!-- ===================================================== -->
        <!-- PRECIO UNITARIO -->
        <!-- ===================================================== -->

        <xpath expr="//td[@name='td_product_priceunit']"
               position="replace">

            <td name="td_product_priceunit"
                class="text-end text-nowrap">

                <t t-if="not collapse_prices">

                    <t t-set="precio_sin_iva"
                       t-value="line.price_subtotal / line.product_uom_qty if line.product_uom_qty else 0"/>

                    <t t-esc="'{:,.2f}'.format(precio_sin_iva)"/>

                </t>

            </td>

        </xpath>

        <!-- ===================================================== -->
        <!-- SUBTOTAL -->
        <!-- ===================================================== -->

        <xpath expr="//td[@name='td_product_subtotal']"
               position="replace">

            <td name="td_product_subtotal"
                class="text-end o_price_total">

                <t t-if="not line.is_downpayment and not collapse_prices">

                    <t t-esc="'{:,.2f}'.format(line.price_subtotal)"/>

                </t>

            </td>

        </xpath>

        <!-- ===================================================== -->
        <!-- TOTALES -->
        <!-- ===================================================== -->

        <xpath expr="//div[@name='total']"
               position="replace">

            <div id="total"
                 class="row mt-2"
                 name="total">

                <div class="col-4 ms-auto">

                    <table class="table table-sm"
                           style="font-size: 8pt;">

                        <!-- SUBTOTAL -->
                        <tr>

                            <td class="text-end">
                                <strong>SUBTOTAL</strong>
                            </td>

                            <td class="text-end">
                                <span t-field="doc.amount_untaxed"/>
                            </td>

                        </tr>

                        <!-- IVA -->
                        <tr>

                            <td class="text-end">
                                <strong>IVA</strong>
                            </td>

                            <td class="text-end">
                                <span t-field="doc.amount_tax"/>
                            </td>

                        </tr>

                        <!-- TOTAL -->
                        <tr style="border-top: 1px solid #73A07B;">

                            <td class="text-end">
                                <strong>TOTAL</strong>
                            </td>

                            <td class="text-end">

                                <strong>
                                    <span t-field="doc.amount_total"/>
                                </strong>

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

        </xpath>

        <!-- ===================================================== -->
        <!-- OBSERVACIONES -->
        <!-- ===================================================== -->

        <xpath expr="//span[@name='order_note']"
               position="replace">

            <div t-if="doc.note"
                 style="background-color: #d1ecf1;
                        border-left: 3px solid #17a2b8;
                        padding: 6px;
                        font-size: 7.5pt;
                        margin-top: 10px;">

                <strong>📌 OBSERVACIONES</strong>

                <br/>

                <span t-field="doc.note"/>

            </div>

        </xpath>

        <!-- ===================================================== -->
        <!-- TÉRMINOS -->
        <!-- ===================================================== -->

        <xpath expr="//p[span[@t-field='doc.payment_term_id.note']]"
               position="replace">

            <div t-if="not is_html_empty(doc.payment_term_id.note)"
                 style="background-color: #e8f5e9;
                        border-left: 3px solid #73A07B;
                        padding: 6px;
                        font-size: 7.5pt;
                        margin-top: 10px;">

                <strong>📋 TÉRMINOS DE PAGO</strong>

                <br/>

                <span t-field="doc.payment_term_id.note"/>

            </div>

        </xpath>

    </template>

</odoo>
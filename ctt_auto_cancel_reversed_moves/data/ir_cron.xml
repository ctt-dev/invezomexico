<odoo>
    <data>
        <record id="ir_cron_ctt_auto_cancel_reversed_moves_daily_cron" model="ir.cron">
            <field name="name">Automatic cancellation for reversed journal entries: Daily cron</field>
            <field name="model_id" ref="model_account_move"/>
            <field name="state">code</field>
            <field name="code">model.cancel_reversed_moves()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- <field name="numbercall">-1</field> -->
            <field name="nextcall" eval="(DateTime.now().replace(hour=9, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')" />
            <field name="active" eval="True"/>
            <!-- <field name="doall" eval="False"/> -->
        </record>
    </data>
</odoo>
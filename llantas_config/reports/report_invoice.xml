<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <template id="invoice_llantired" inherit_id="account.report_invoice_document" priority="99">
            
            <!-- Columna Código SAT -->
            <xpath expr="//th[@name='th_description']" position="after">
                <th name="th_sat_code" class="text-start"><span>Código SAT</span></th>
            </xpath>

            <!-- Celda Código SAT -->
            <xpath expr="//td[@name='account_invoice_line_name']" position="after">
                <td name="td_sat_code">
                    <span t-field="line.product_id.unspsc_code_id.code" t-options="{'widget': 'text'}"/>
                </td>
            </xpath>

            <!-- Hacer más pequeña la letra de toda la tabla -->
            <xpath expr="//table[@name='invoice_line_table']" position="attributes">
                <attribute name="style">font-size: 8pt;</attribute>
            </xpath>

            <xpath expr="//table[@name='invoice_line_table']//th" position="attributes">
                <attribute name="style">font-size: 7pt; padding: 4px;</attribute>
            </xpath>

            <xpath expr="//table[@name='invoice_line_table']//td" position="attributes">
                <attribute name="style">font-size: 7pt; padding: 3px;</attribute>
            </xpath>

            <!-- Tipo de Cambio -->
            <xpath expr="//div[@id='informations']" position="after">
                <div class="row mb-2" t-if="o.currency_id.name == 'USD'">
                    <div class="col">
                        <strong>Tipo de Cambio:</strong> <span t-field="o.exchange_rate"/>
                    </div>
                </div>
            </xpath>

            <!-- Datos Bancarios y Términos de Pago -->
            <xpath expr="//div[@id='right-elements']" position="before">
                <div style="clear: both;"></div>
                <div class="mt-2 mb-2" style="width: 100%; float: left;">
                    
                    <!-- Datos Bancarios -->
                    <div style="width: 45%; float: left; font-size: 8pt;" t-if="o.move_type == 'out_invoice' and o.state == 'posted'">
                        <strong style="background-color: #73A07B; color: white; display: block; padding: 5px;">DATOS PARA TRANSFERENCIA BANCARIA</strong>
                        <table class="table table-sm" style="margin-bottom: 0; font-size: 8pt;">
                            <tbody>
                                <tr>
                                    <td style="width: 30%;"><strong>BANCO:</strong></td>
                                    <td>
                                        <t t-if="o.currency_id.name == 'USD'">BANORTE (DÓLARES)</t>
                                        <t t-else="">HSBC</t>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>CONCEPTO:</strong></td>
                                    <td><span t-field="o.payment_reference" t-options="{'widget': 'text'}"/></td>
                                </tr>
                                <tr>
                                    <td><strong>CLABE:</strong></td>
                                    <td>
                                        <t t-if="o.company_id.name == 'LLANTIRED' and o.currency_id.name == 'MXN'">021743040678913582</t>
                                        <t t-elif="o.company_id.name == 'LLANTIRED' and o.currency_id.name == 'USD'">072731013015735748</t>
                                        <t t-elif="o.company_id.name == 'LA BODEGA LLANTAS Y ACCESORIOS' and o.currency_id.name == 'MXN'">021743040189731499</t>
                                        <t t-elif="o.company_id.name == 'LA BODEGA LLANTAS Y ACCESORIOS' and o.currency_id.name == 'USD'">021743070004580915</t>
                                        <t t-elif="o.company_id.name == 'A-DRONE'">072731011952302184</t>
                                        <t t-else=""><span t-field="o.company_id.bank_ids.acc_number"/></t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Términos de Pago -->
                    <div style="width: 45%; float: right; font-size: 8pt;">
                        <strong style="background-color: #f0f0f0; display: block; padding: 5px;">TÉRMINOS DE PAGO</strong>
                        <div style="padding: 8px;">
                            <span t-field="o.invoice_payment_term_id.note"/>
                            <span t-if="not o.invoice_payment_term_id.note" t-field="o.invoice_payment_term_id.name"/>
                        </div>
                    </div>
                </div>
            </xpath>

            <!-- Cambiar el encabezado de Precio Unitario para que diga "Precio SIN IVA" -->
            <xpath expr="//th[@name='th_priceunit']/span" position="replace">
                <span>Precio SIN IVA</span>
            </xpath>

            <!-- Mostrar Precio Unitario SIN IVA -->
            <xpath expr="//td[@name='td_price_unit']/span" position="replace">
                <span t-if="not hide_prices" class="text-nowrap">
                    <t t-set="price_without_tax" t-value="line.price_unit / (1 + (line.tax_ids.amount / 100)) if line.tax_ids.amount else line.price_unit"/>
                    <t t-esc="'%.4f' % price_without_tax"/>
                </span>
            </xpath>

            <!-- Mostrar Subtotal SIN IVA (cantidad × precio sin IVA) -->
            <xpath expr="//td[@name='td_subtotal']/span[1]" position="replace">
                <span t-if="not hide_prices" class="text-nowrap">
                    <t t-set="price_without_tax" t-value="line.price_unit / (1 + (line.tax_ids.amount / 100)) if line.tax_ids.amount else line.price_unit"/>
                    <t t-set="subtotal_without_tax" t-value="price_without_tax * line.quantity"/>
                    <t t-esc="'%.4f' % subtotal_without_tax"/>
                </span>
            </xpath>

        </template>

    </data>
</odoo>
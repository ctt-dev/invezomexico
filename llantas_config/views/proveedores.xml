                <record model="ir.actions.act_window" id="llantas_proveedores_links">
                    <field name="name">Proveedores links</field>
                    <field name="res_model">llantas_config.proveedores_links</field>
                    <field name="view_mode">list</field>
                    <field name="context">{'create': True,'edit': True}</field>
                    <field name="target">main</field>
                </record>
                
                <menuitem id="llantas_proveedores_links_menu_list" 
                          name="Proveedores links" 
                          action="llantas_proveedores_links"
                          parent="menu_ctt_llantas_marketplace_list" 
                          sequence="102" />

                <record id="action_view_import_existencias_proveedores" model="ir.actions.act_window">
            <field name="name">Importar existencias proveedores</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">llantas_config.ctt_prov_cargar_wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <record id="view_wizard_existencias_proveedor_form" model="ir.ui.view">
            <field name="name">Importar existencia de proveedores</field>
            <field name="model">llantas_config.proveedores_links_wizard</field>
            <field name="arch" type="xml">
                <form string="Importar Documento" class="oe_form_container">

                        <div class="oe_form_group">
                            <span>¿Deseas procesar el proveedor: </span>
                            <field name="proveedores_links_id" readonly="1"/>
                        <br/> 
                            <span>Límite por procesar: </span>
                            <field name="limite" required="1"/>
                        </div>

                    <footer>
                        <button name="action_button_procesar" string="Procesar" type="object" class="btn-primary"/>
                        <button special="cancel" string="Cancelar" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>


        <menuitem id="menu_ctt_llantas_proveedores_list" name="Listado proveedores" parent="menu_ctt_llantas_marketplace_list" sequence="2" action="ctt_llantas_action_proveedor_list_form"/>
    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Heredar del template de MX EDI -->
        <template id="invoice_llantired" inherit_id="l10n_mx_edi.report_invoice_document" priority="99">
    
            <!-- ====================================================== -->
            <!-- ELIMINAR FECHA LÍMITE, FECHA ENTREGA Y REFERENCIA -->
            <!-- ====================================================== -->
            
            <!-- Eliminar Due Date -->
            <xpath expr="//div[@id='informations']//div[@name='due_date']" position="replace"/>
            
            <!-- Eliminar Delivery Date -->
            <xpath expr="//div[@id='informations']//div[@name='delivery_date']" position="replace"/>
            
            <!-- Eliminar Reference -->
            <!-- <xpath expr="//div[@id='informations']//div[@name='reference']" position="replace"/> -->
            
            <!-- ====================================================== -->
            <!-- ESTILOS GENERALES PARA LA TABLA -->
            <!-- ====================================================== -->
            <xpath expr="//table[@name='invoice_line_table']" position="attributes">
                <attribute name="style">
                    width:100%;
                    font-size:7pt;
                    table-layout:fixed;
                    border-collapse:collapse;
                    border:1px solid #d9d9d9;
                </attribute>
            </xpath>
            
            <!-- ====================================================== -->
            <!-- AGREGAR COLUMNA SKU (ANTES DEL CÓDIGO SAT) -->
            <!-- ====================================================== -->
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_product_unspsc_code']" position="before">
                <th class="text-center" name="th_sku" style="background:#73A07B; color:white; font-size:7pt; font-weight:bold; padding:5px; border:1px solid #5f8a66; text-align:center; vertical-align:middle;">
                    <span>SKU</span>
                </th>
            </xpath>
            
            <!-- Cambiar título de "Product code" a "Código SAT" y asegurar fondo -->
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_product_unspsc_code']" position="attributes">
                <attribute name="style">background:#73A07B; color:white; font-size:7pt; font-weight:bold; padding:5px; border:1px solid #5f8a66; text-align:center; vertical-align:middle;</attribute>
            </xpath>
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_product_unspsc_code']/span" position="replace">
                <span>Código SAT</span>
            </xpath>
            
            <!-- Cambiar título de "Unit code" a "Unidad SAT" y asegurar fondo -->
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_product_uom_unspsc_code']" position="attributes">
                <attribute name="style">background:#73A07B; color:white; font-size:7pt; font-weight:bold; padding:5px; border:1px solid #5f8a66; text-align:center; vertical-align:middle;</attribute>
            </xpath>
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_product_uom_unspsc_code']/span" position="replace">
                <span>Unidad SAT</span>
            </xpath>
            
            <!-- ====================================================== -->
            <!-- ESTILOS PARA ENCABEZADOS -->
            <!-- ====================================================== -->
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_description']" position="attributes">
                <attribute name="style">background:#73A07B; color:white; font-size:7pt; font-weight:bold; padding:5px; border:1px solid #5f8a66; text-align:center; vertical-align:middle;</attribute>
            </xpath>
            
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_quantity']" position="attributes">
                <attribute name="style">background:#73A07B; color:white; font-size:7pt; font-weight:bold; padding:5px; border:1px solid #5f8a66; text-align:center; vertical-align:middle;</attribute>
            </xpath>
            
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_priceunit']" position="attributes">
                <attribute name="style">background:#73A07B; color:white; font-size:7pt; font-weight:bold; padding:5px; border:1px solid #5f8a66; text-align:center; vertical-align:middle;</attribute>
            </xpath>
            
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_discount']" position="attributes">
                <attribute name="style">background:#73A07B; color:white; font-size:7pt; font-weight:bold; padding:5px; border:1px solid #5f8a66; text-align:center; vertical-align:middle;</attribute>
            </xpath>
            
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_taxes']" position="attributes">
                <attribute name="style">background:#73A07B; color:white; font-size:7pt; font-weight:bold; padding:5px; border:1px solid #5f8a66; text-align:center; vertical-align:middle;</attribute>
            </xpath>
            
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_subtotal']" position="attributes">
                <attribute name="style">background:#73A07B; color:white; font-size:7pt; font-weight:bold; padding:5px; border:1px solid #5f8a66; text-align:center; vertical-align:middle;</attribute>
            </xpath>
            
            <!-- ====================================================== -->
            <!-- CELDA SKU (DATOS) -->
            <!-- ====================================================== -->
            <xpath expr="//table[@name='invoice_line_table']//td[@name='td_product_unspsc_code']" position="before">
                <td name="td_sku" class="text-center" style="background:#f8f8f8; font-size:7pt; padding:4px; border-bottom:1px solid #e5e5e5; vertical-align:middle; width:10%;">
                    <span t-field="line.product_id.default_code"/>
                </td>
            </xpath>
            
            <!-- Estilo celdas Código SAT -->
            <xpath expr="//table[@name='invoice_line_table']//td[@name='td_product_unspsc_code']" position="attributes">
                <attribute name="style">background:#f8f8f8; font-size:7pt; padding:4px; border-bottom:1px solid #e5e5e5; vertical-align:middle; text-align:center; width:12%;</attribute>
            </xpath>
            
            <!-- Unidad SAT - Mostrar "CÓDIGO - NOMBRE" -->
            <xpath expr="//table[@name='invoice_line_table']//td[@name='td_product_uom_unspsc_code']" position="replace">
                <td name="td_product_uom_unspsc_code" class="text-center" style="background:#f8f8f8; font-size:7pt; padding:4px; border-bottom:1px solid #e5e5e5; vertical-align:middle; width:12%;">
                    <t t-set="unspsc_code" t-value="line._get_uom_unspsc_code()"/>
                    <span t-out="unspsc_code"/>
                    <t t-if="unspsc_code == 'H87'"> - Pieza</t>
                    <t t-elif="unspsc_code == 'EA'"> - Cada uno</t>
                    <t t-elif="unspsc_code == 'MTK'"> - Metro cuadrado</t>
                    <t t-elif="unspsc_code == 'MTR'"> - Metro</t>
                    <t t-elif="unspsc_code == 'KGM'"> - Kilogramo</t>
                    <t t-elif="unspsc_code == 'LTR'"> - Litro</t>
                    <t t-elif="unspsc_code == 'C62'"> - Unidad</t>
                    <t t-elif="unspsc_code == 'BX'"> - Caja</t>
                    <t t-elif="unspsc_code == 'DZN'"> - Docena</t>
                    <t t-elif="unspsc_code == 'SET'"> - Juego</t>
                    <t t-elif="unspsc_code == 'PR'"> - Par</t>
                </td>
            </xpath>
            
            <!-- Descripción - Usar line.name en lugar de product_id.name -->
            <xpath expr="//table[@name='invoice_line_table']//td[@name='account_invoice_line_name']" position="attributes">
                <attribute name="style">background:#f8f8f8; font-weight:500; font-size:7pt; padding:4px; border-bottom:1px solid #e5e5e5; vertical-align:middle; text-align:left;</attribute>
            </xpath>
            
            <xpath expr="//td[@name='account_invoice_line_name']" position="replace">
                <td name="account_invoice_line_name" t-att-class="padding_class" style="width:20%; background:#f8f8f8; font-weight:500; font-size:7pt; padding:4px; border-bottom:1px solid #e5e5e5; vertical-align:middle; text-align:left;">
                    <span t-if="line.product_id" t-field="line.product_id.name" t-options="{'widget': 'text'}" dir="auto"/>
                    <span t-else="" t-field="line.name" t-options="{'widget': 'text'}" dir="auto"/>
                </td>
            </xpath>
            
            <!-- Impuestos - Corregir alineación vertical -->
            <xpath expr="//td[@name='td_taxes']" position="replace">
                <td name="td_taxes" t-if="display_taxes" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}" style="background:#f8f8f8; font-size:7pt; padding:4px; border-bottom:1px solid #e5e5e5; vertical-align:middle;">
                    <span t-if="not hide_prices" t-out="taxes" id="line_tax_ids">Tax 15%</span>
                </td>
            </xpath>
            
            <!-- Cantidad + Unidad comercial -->
            <xpath expr="//table[@name='invoice_line_table']//td[@name='td_quantity']" position="attributes">
                <attribute name="style">background:#f8f8f8; font-size:7pt; padding:4px; border-bottom:1px solid #e5e5e5; vertical-align:middle; text-align:center;</attribute>
            </xpath>
            
            <!-- Precio Unitario -->
            <xpath expr="//table[@name='invoice_line_table']//td[@name='td_price_unit']" position="attributes">
                <attribute name="style">background:#f8f8f8; font-size:7pt; padding:4px; border-bottom:1px solid #e5e5e5; vertical-align:middle; text-align:end;</attribute>
            </xpath>
            <!-- Precio Unitario (SIN IVA) -->
            <xpath expr="//table[@name='invoice_line_table']//td[@name='td_price_unit']" position="replace">
                <td name="td_price_unit" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" style="background:#f8f8f8; font-size:7pt; padding:4px; border-bottom:1px solid #e5e5e5; vertical-align:middle;">
                    <span t-if="not hide_prices">
                        <t t-set="tax_rate" t-value="0.0"/>
                        <t t-foreach="line.tax_ids" t-as="tax">
                            <t t-if="tax.amount_type == 'percent'">
                                <t t-set="tax_rate" t-value="tax_rate + tax.amount"/>
                            </t>
                        </t>
                        <t t-set="price_without_tax" t-value="line.price_unit / (1 + (tax_rate / 100)) if tax_rate else line.price_unit"/>
                        <t t-esc="'{:,.2f}'.format(price_without_tax)"/>
                    </span>
                </td>
            </xpath>
            
            <!-- Subtotal -->
            <xpath expr="//table[@name='invoice_line_table']//td[@name='td_subtotal']" position="attributes">
                <attribute name="style">background:#f8f8f8; font-size:7pt; padding:4px; border-bottom:1px solid #e5e5e5; vertical-align:middle; text-align:end;</attribute>
            </xpath>
            
            <!-- Cambiar texto del encabezado Precio -->
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_priceunit']/span" position="replace">
                <span>Precio SIN IVA</span>
            </xpath>
            
            <!-- ====================================================== -->
            <!-- SECCIÓN DE INFORMACIÓN -->
            <!-- ====================================================== -->
            <xpath expr="//div[@id='informations']" position="attributes">
                <attribute name="style">font-size:12px !important; line-height:1.4; margin-bottom:10px;</attribute>
            </xpath>
            
            <!-- Agregar Moneda -->
            <xpath expr="//div[@id='informations']" position="inside">
                <div class="col" style="font-size:12px;">
                    <strong>Moneda:</strong>
                    <span t-esc="o.currency_id.name"/>
                </div>
            </xpath>
            
            <!-- Tipo de Cambio después de informaciones -->
            <xpath expr="//div[@id='informations']" position="after">
                <div class="row mb-2" t-if="o.currency_id.name == 'USD'" style="font-size:12px;">
                    <div class="col">
                        <strong>Tipo de Cambio:</strong>
                        <span t-esc="'%.6f' % (o.exchange_rate or 0.0)"/>
                    </div>
                </div>
            </xpath>

            <!-- MONTOS EN LETRA - CON MÉTODO PERSONALIZADO -->
            <!-- ====================================================== -->
            <xpath expr="//p[hasclass('text-end', 'lh-sm')]" position="replace">
                <p class="text-end lh-sm" style="font-size:13px; text-align:right;">
                    <strong>Total en letra:</strong><br/>
                    <span style="font-size:12pt;" t-out="o._get_amount_words_clean()"/>
                </p>
            </xpath>
            
            <!-- ====================================================== -->
            <!-- TABLA DE TOTALES - REDUCIR TAMAÑO DE LETRA A 13 -->
            <!-- ====================================================== -->
            <xpath expr="//div[@id='total']" position="attributes">
                <attribute name="style">font-size:13px !important; line-height:1.2; margin-top:5px;</attribute>
            </xpath>
            
            <!-- ====================================================== -->
            <!-- MONTOS EN LETRA - AGREGAR DEBAJO DE TOTALES -->
            <!-- ====================================================== -->
            <!--<xpath expr="//div[@id='total']" position="after">-->
            <!--    <div class="row mt-2 mb-2" style="width:100%;">-->
            <!--        <div class="col-12">-->
            <!--            <p class="lh-sm" style="font-size:8pt; text-align:right;">-->
            <!--                <strong>Total en letra:</strong><br/>-->
            <!--                <span t-field="o.amount_total_words" style="font-size:7pt;"/>-->
            <!--            </p>-->
            <!--        </div>-->
            <!--    </div>-->
            <!--</xpath>-->
            
            <!-- ====================================================== -->
            <!-- DATOS BANCARIOS -->
            <!-- ====================================================== -->
            <xpath expr="//p[@name='payment_communication']" position="inside">
                <div class="row mt-2" style="width:40%; font-size:8pt;">
                    <div class="col-12">
                        <div t-if="o.move_type == 'out_invoice' and o.state == 'posted'" style="border:1px solid #d9d9d9; margin-bottom:6px;">
                            <div style="background:#73A07B; color:white; padding:4px 6px; font-weight:bold; font-size:8pt;">
                                DATOS PARA TRANSFERENCIA BANCARIA
                            </div>
                            <table style="width:100%; font-size:7pt; border-collapse:collapse;">
                                <tbody>
                                    <tr>
                                        <td style="padding:2px 4px; width:28%;"><strong>BANCO:</strong></td>
                                        <td style="padding:2px 4px;">
                                            <t t-if="o.currency_id.name == 'USD'">BANORTE (DÓLARES)</t>
                                            <t t-else="">HSBC</t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:2px 4px;"><strong>CONCEPTO:</strong></td>
                                        <td style="padding:2px 4px;">
                                            <span t-field="o.payment_reference" t-options="{'widget': 'text'}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:2px 4px;"><strong>CLABE:</strong></td>
                                        <td style="padding:2px 4px;">
                                            <t t-if="o.company_id.name == 'LLANTIRED' and o.currency_id.name == 'MXN'">
                                                021743040678913582
                                            </t>
                                            <t t-elif="o.company_id.name == 'LLANTIRED' and o.currency_id.name == 'USD'">
                                                072731013015735748
                                            </t>
                                            <t t-elif="o.company_id.name == 'LA BODEGA LLANTAS Y ACCESORIOS' and o.currency_id.name == 'MXN'">
                                                021743040189731499
                                            </t>
                                            <t t-elif="o.company_id.name == 'LA BODEGA LLANTAS Y ACCESORIOS' and o.currency_id.name == 'USD'">
                                                021743070004580915
                                            </t>
                                            <t t-elif="o.company_id.name == 'A-DRONE'">
                                                072731011952302184
                                            </t>
                                            <t t-else="">
                                                <span t-field="o.company_id.bank_ids.acc_number"/>
                                            </t>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </xpath>
            
            <!-- Estilo comentarios -->
            <xpath expr="//div[@name='comment']" position="attributes">
                <attribute name="style">font-size:8pt !important; line-height:1.2 !important; margin-bottom:2px !important; text-align:justify;</attribute>
            </xpath>
    
            
        </template>
    </data>
</odoo>
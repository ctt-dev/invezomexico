<odoo>
    <data>
        <record id="view_product_template_pos_form1" model="ir.ui.view">
            <field name="name">Product.template.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                 <xpath expr="//page[@name='general_information']//group//group[@name='group_general']//field[@name='product_tooltip']" position="after">
                     <field name="es_llanta"/>
                     <field name="es_paquete"/>
                     <field name="pkg_type" invisible="not es_paquete" required="es_paquete"/>
                     <field name="sku_alternos" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                     <field name="marca_llanta" />
                     <field name="modelo_llanta" />
                     <field name="medida_llanta" />
                     <field name="indice_carga" />
                     <field name="indice_velocidad" />
                     <field name="ancho" class="oe_inline"/>
                     <field name="alto" class="oe_inline"/>
                     <field name="rin" />
                     <field name="config_marketplace_id" widget="many2one_tags" force_save="1" invisible="1"/>
                     <field name="config_marketplace_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                 </xpath>
                <xpath expr="//page[@name='general_information']//group//group[@name='group_standard_price']//field[@name='company_id']" position="after">
                    <!-- <field name="is_killer" />
                    <field name="killer_initial_date" invisible="not is_killer" readonly="1" />
                     <field name="killer_date" invisible="not is_killer" readonly="1"/>
                    <field name="killer_price" widget="monetary" invisible="not is_killer" />
                    <field name="killer_id" invisible="0" readonly="1"/> -->
                    <!-- <field name="killer_ids" widget="many2many_tags"/> -->
                </xpath>
                <!-- <xpath expr="//page[@name='inventory']//group//group//div[2]" position="after">
                     <label for="largo" invisible="product_variant_count &gt; 1 and not is_product_variant"/>
                        <div class="o_row" invisible="product_variant_count &gt; 1 and not is_product_variant">
                            <field name="largo" class="oe_inline"/>
                        </div>
                    <label for="ancho" invisible="product_variant_count &gt; 1 and not is_product_variant"/>
                        <div class="o_row" invisible="product_variant_count &gt; 1 and not is_product_variant">
                            <field name="ancho" class="oe_inline"/>
                    </div>
                    <label for="alto" invisible="product_variant_count &gt; 1 and not is_product_variant"/>
                        <div class="o_row" invisible="product_variant_count &gt; 1 and not is_product_variant">
                            <field name="alto" class="oe_inline"/>
                    </div>
                </xpath> -->
                <xpath expr="//page[@name='inventory']" position="after">
                    <page string="Marketplaces">
                        <field name="config_marketplace_ids" mode="kanban">
                            <kanban>
                                <field name="id" />
                                <field name="name"/>
                                <field name="listado_marketplace" />  <!-- IMPORTANTE: Este campo debe estar aquí -->
                                <field name="tipo_producto"/>
                                <field name="image_1920"/>
                                <templates>
                                    <t t-name="card" class="flex-row">
                                        <main class="pe-2">
                                            <div class="mb-1">
                                                <div class="d-flex mb-0 h5">
                                                    <b style="font-size:15px" t-if="record.listado_marketplace">
                                                        <!-- Intenta primero con value en lugar de raw_value -->
                                                        <t t-esc="record.data.listado_marketplace or ''"/>
                                                    </b>
                                                    <b style="font-size:15px" t-else="">
                                                        Sin listado
                                                    </b>
                                                </div>
                                            </div>
                                            <span t-if="record.tipo_producto">
                                                Tipo: <t t-esc="record.data.tipo_producto or ''"/>
                                            </span>
                                            <span t-else="">
                                                Tipo: No especificado
                                            </span>
                                        </main>
                                        <aside t-if="record.image_1920 and (record.image_1920.value or record.data.image_1920)">
                                            <field name="image_1920" widget="image" alt="Marketplace" options="{'img_class': 'w-100 object-fit-contain', 'preview_image': 'image_1920'}"/>
                                        </aside>
                                    </t>
                                </templates>
                            </kanban>
                            <form string="Marketplace">
                                <sheet>
                                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'avatar_128'}"/>
                                    <group>
                                        <field name="listado_marketplace" required="1" widget="radio" options="{'horizontal': true}"/>
                                        <group>
                                            <field name="tipo_producto" required="1" widget="selection" />
                                        </group>
                                    </group>
                                    <field name="id" invisible="1"/>
                                    
                                    <group>
                                        <group string="Codigo">
                                            <field name="codigo_paquete_clasico" />
                                            <field name="codigo_paquete_premium" />
                                        </group>
                                        <group string="ID">
                                            <field name="id_clasico" />
                                            <field name="id_premium" />
                                            <field name="id_paquete_clasico" />
                                            <field name="id_paquete_premium" />
                                        </group>
                                        
                                        <group string="Categorias">
                                            <field name="categoria"/>
                                            <field name="garantia"/>
                                        </group>
                                        
                                        <group string="SKU">
                                            <field name="sku_individual" />
                                            <field name="sku_paquete" />
                                        </group>
                                        <group string="Codigos">
                                            <field name="codigo_ean" />
                                            <field name="codigo_ean_paquete" />
                                            <field name="codigo_proveedor" />
                                        </group>
                                        <group string="Info extra">
                                            <field name="no_tienda" />
                                            <field name="no_proveedor" />
                                            <field name="grupo_articulo" />
                                            <field name="palabra_clave" />
                                            <field name="precio" />
                                            <field name="precio_descuento" />
                                            <field name="estado_publicacion" />
                                            <field name="condicion" />
                                            <field name="garantia" />
                                        </group>
                                        <group string="Información llantas" invisible="tipo_producto != '01'">
                                            <field name="marca" />
                                            <field name="modelo" />
                                            <field name="peso" />
                                            <field name="medida" />
                                            <field name="material" />
                                            <field name="medida_llanta" />
                                            <field name="medida_rin" />
                                        </group>  
                                        <group string="Información amortiguadores" invisible="tipo_producto != '02'">
                                            <field name="marca" />
                                            <field name="modelo" />
                                            <field name="tipo_vehiculo" />
                                            <field name="posicion" />
                                            <field name="lado" />
                                            <field name="ano_vehiculo" />
                                        </group>
                                        <group string="Información maquina de hielo" invisible="tipo_producto != '03'">
                                            <field name="marca" />
                                            <field name="modelo" />
                                            <field name="voltaje" />
                                            <field name="potencia" />
                                            <field name="capacidad_produccion" />
                                            <field name="capacidad_almacenamiento" />
                                            <field name="forma_hielo" />
                                            <field name="material" />
                                        </group>
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </xpath>
                <xpath expr="//page[@name='general_information']" position="after">
                    <page string="Listado killers">
                        <div>
                            <field name="killer_ids" options="{'no_create_edit': True}">
                                <list>
                                    <field name="product_id" widget="many2one"/>
                                    <field name="sku" />
                                    <field name="base_price" widget="monetary"/>
                                    <field name="promotion_price" widget="monetary"/>
                                    <field name="killer_price" widget="monetary"/>
                                    <field name="initial_date" />
                                    <field name="final_date" />
                                    <field name="marketplace_id" widget="many2one"/>
                                    <field name="status" widget="badge"
                                        decoration-danger="status == 'cancelled'"
                                        decoration-muted="status == 'expired'"
                                        decoration-success="status == 'active'"
                                        decoration-warning="status == 'pause'"/>
                                </list>
                            </field>
                        </div>
                    </page>
                    <page string="Compatibilidad">
                        <div>
                            <field name="compatibilidad_ids" string="Compatibilidad" options="{'no_create_edit': True}">
                                <list>
                                    <field name="brand_id" widget="many2one"/> 
                                    <field name="model_id" widget="many2one"/>
                                    <field name="year" widget="year"/>
                                    <field name="version" />
                                    <field name="medida" />
                                </list>
                            </field>
                        </div>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="view_product_template_kanban_inherit" model="ir.ui.view">
            <field name="name">Product_template_kanban_inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_kanban_view"/>
            <field name="arch" type="xml">
                <!-- En Odoo 19, el template se llama 'card' y tiene estructura main/aside -->
                <xpath expr="//t[@t-name='card']//main" position="inside">
                    <div t-if="record.es_llanta" class="mt-2 small">
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge bg-light text-dark me-1" t-if="record.alto.value">
                                <b>Alto:</b> <t t-esc="record.alto.value"/>
                            </span>
                            <span class="badge bg-light text-dark me-1" t-if="record.ancho.value">
                                <b>Ancho:</b> <t t-esc="record.ancho.value"/>
                            </span>
                            <span class="badge bg-light text-dark me-1" t-if="record.rin.value">
                                <b>Rin:</b> <t t-esc="record.rin.value"/>
                            </span>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-1">
                            <span class="badge bg-light text-dark me-1" t-if="record.marca_llanta.value">
                                <b>Marca:</b> <t t-esc="record.marca_llanta.value"/>
                            </span>
                            <span class="badge bg-light text-dark me-1" t-if="record.modelo_llanta.value">
                                <b>Modelo:</b> <t t-esc="record.modelo_llanta.value"/>
                            </span>
                            <span class="badge bg-light text-dark me-1" t-if="record.medida_llanta.value">
                                <b>Medida:</b> <t t-esc="record.medida_llanta.value"/>
                            </span>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
        
        <record id="view_product_search" model="ir.ui.view">
            <field name="name">productos_search</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_search_view"/>
            <field name="arch" type="xml">
                 <xpath expr="//search//field[@name='name']" position="replace">
                    <field name="name" string="Product" filter_domain="['|', '|', '|', '|', ('default_code', 'ilike', self), ('product_variant_ids.default_code', 'ilike', self),('name', 'ilike', self), ('barcode', 'ilike', self), ('sku_alternos', 'ilike', self)]"/>
                    <field name="sku_alternos" string="Sku alterno" filter_domain="[('sku_alternos', 'ilike', self)]"/>
                    <field name="alto" class="oe_inline"/>
                    <field name="ancho" class="oe_inline"/>
                    <field name="rin" />
                    <field name="modelo_llanta" />
                    <field name="marca_llanta" />
                    <field name="medida_llanta" />
                </xpath>
            </field>
        </record>

        <record id="view_product_supplierinfo" model="ir.ui.view">
            <field name="name">productos_supplierinfo</field>
            <field name="model">product.supplierinfo</field>
            <field name="inherit_id" ref="product.product_supplierinfo_tree_view"/>
            <field name="arch" type="xml">
                 <xpath expr="//list//field[@name='min_qty']" position="before">
                    <field name="existencia_actual" optional="hide"/>
                    <field name="precio_neto" optional="hide"/>
                    <field name="tipo_cambio" optional="hide"/>
                    <field name="tipo_moneda_proveedor" optional="hide"/>
                    <field name="ultima_actualizacion" optional="show"/>
                </xpath>
            </field>
        </record>

        <record id="view_product_template_tree_inherit" model="ir.ui.view">
            <field name="name">product.template.tree.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='qty_available']" position="replace">
                    <field name="show_on_hand_qty_status_button" invisible="1"/>
                    <field name="qty_available" />
                    <field name="qty_suppliers_total" widget="product_suppliers" invisible="not show_on_hand_qty_status_button" optional="show" decoration-danger="qty_available &lt; 0"/>
                </xpath>
            </field>
        </record>

        <record id="view_product_product_existencias" model="ir.ui.view">
            <field name="name">productos_supplierinfo</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="stock.product_product_stock_tree"/>
            <field name="arch" type="xml">
                 <xpath expr="//list//field[@name='free_qty']" position="replace">
                    <field name="free_qty" string="Libre de usar" sum="free_qty"/>
                </xpath>
                <xpath expr="//list//field[@name='virtual_available']" position="replace">
                    <field name="virtual_available" string="Previsión" optional="hide" sum="virtual_available"/>
                </xpath>
                <xpath expr="//list//button[@name='action_view_orderpoints']" position="replace">
                    <button name="action_view_orderpoints" string="Reabastecimiento" type="object" class="btn-link" icon="fa-refresh" context="{'search_default_product_id': id, 'is_stock_report': True}"/>
                </xpath>
                <xpath expr="//list//field[@name='uom_id']" position="replace">
                    <field name="uom_id" string="Udm" groups="uom.group_uom" options="{'no_create': True}"/>
                </xpath>
                <xpath expr="//list//button[@name='553']" position="replace">
                    <button name="553" string="Ubicaciones" type="action" class="btn-link" groups="stock.group_stock_multi_locations" icon="fa-cubes" context="{'search_default_product_id': id, 'default_product_id': id}" invisible="qty_available == 0"/>
                </xpath>
                <xpath expr="//list//button[@name='action_product_forecast_report']" position="replace">
                    <button name="action_product_forecast_report" string="Previsión" type="object" class="btn-link" icon="fa-area-chart" context="{'default_product_id': id}" invisible="incoming_qty == 0 and outgoing_qty == 0"/>
                </xpath>
                <xpath expr="//list//button[@name='560']" position="replace">
                    <button name="560" string="Historial" type="action" class="btn-link" icon="fa-history" context="{'search_default_product_id': id, 'default_product_id': id}"/>
                </xpath> 
            </field>
        </record>
    </data>
</odoo>
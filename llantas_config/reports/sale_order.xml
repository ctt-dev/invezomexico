<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="sale_order_report_document_for_llantas"
              inherit_id="sale.report_saleorder_document">

        <!-- ADDRESS -->
        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address">
                <div t-field="doc.partner_id" class="mb-0"
                     t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>
                <p t-if="doc.partner_id.vat" class="mb-0">
                    <t t-if="doc.company_id.account_fiscal_country_id.vat_label"
                       t-out="doc.company_id.account_fiscal_country_id.vat_label"/>
                    <t t-else="">RFC</t>:
                    <span t-field="doc.partner_id.vat"/>
                </p>
            </t>
        </xpath>

        <!-- TITULO -->
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title">
                <span t-if="is_proforma">Factura Proforma # </span>
                <span t-elif="doc.state == 'draft' or doc.state == 'sent'">Cotización # </span>
                <span t-else="">Orden # </span>
                <span t-field="doc.name"/>
            </t>
        </xpath>

        <!-- INFORMACIONES (con tipo de cambio al lado del vendedor) -->
        <xpath expr="//div[@id='informations']" position="replace">
            <div class="row mb-1" id="informations"
                 style="font-size:12px; line-height:1.2;">

                <div t-if="doc.folio_venta" class="col-2" name="folio_venta">
                    <strong>No. Venta:</strong><br/>
                    <span t-field="doc.folio_venta"/>
                </div>
                <div t-if="doc.client_order_ref" class="col-2" name="informations_reference">
                    <strong>Su Referencia:</strong><br/>
                    <span t-field="doc.client_order_ref"/>
                </div>
                <div t-if="doc.date_order" class="col-2" name="informations_date">
                    <strong t-if="doc.state == 'draft' or doc.state == 'sent'">Fecha Cot.:</strong>
                    <strong t-else="">Fecha Orden:</strong><br/>
                    <span t-field="doc.date_order" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>
                </div>
                <div t-if="doc.validity_date and (doc.state == 'draft' or doc.state == 'sent')"
                     class="col-2" name="expiration_date">
                    <strong>Vencimiento:</strong><br/>
                    <span t-field="doc.validity_date"/>
                </div>
                <!-- VENDEDOR + TIPO DE CAMBIO al lado -->
                <div class="col-2" name="vendedor_tipo_cambio">
                    <strong>Vendedor:</strong><br/>
                    <span t-field="doc.user_id"/>
                    
                </div>
                <div class="col-2" name="tipo_cambio" t-if="doc.currency_id.name == 'USD'">
                    <strong>Tipo de cambio:</strong>
                        <span t-esc="1 / doc.currency_rate" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>
                    
                </div>
                

            </div>
        </xpath>

        <!-- OCULTAR IMPUESTOS -->
        <xpath expr="//t[@t-set='display_taxes']" position="replace">
            <t t-set="display_taxes" t-value="False"/>
        </xpath>

        <!-- ESTILOS COMPACTOS EN TABLA -->
        <xpath expr="//table[hasclass('o_main_table')]" position="attributes">
            <attribute name="style">font-size:9px; margin-top:2px !important;</attribute>
        </xpath>

        <!-- HEADERS -->
        <xpath expr="//thead/tr" position="replace">
            <tr style="font-size:9px;">
                <th name="th_description" class="text-start py-1">Descripción</th>
                <th name="th_quantity" class="text-end py-1 text-nowrap">Cant.</th>
                <th name="th_priceunit" class="text-end py-1 text-nowrap">P. Unit.</th>
                <th name="th_discount" t-if="display_discount" class="text-end py-1">Desc.%</th>
                <th name="th_subtotal" class="text-end py-1">Importe</th>
            </tr>
        </xpath>

        <!-- NOMBRE PRODUCTO -->
        <xpath expr="//td[@name='td_product_name']" position="attributes">
            <attribute name="class">py-1</attribute>
        </xpath>

        <!-- CANTIDAD -->
        <xpath expr="//td[@name='td_product_quantity']" position="attributes">
            <attribute name="class">o_td_quantity text-end py-1</attribute>
        </xpath>

        <!-- PRECIO UNITARIO SIN IVA (mostrando moneda) -->
        <xpath expr="//td[@name='td_product_priceunit']" position="replace">
            <td name="td_product_priceunit" class="text-end text-nowrap py-1">
                <t t-if="not collapse_prices">
                    <span t-esc="line.price_unit / 1.16"
                          t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>
                </t>
            </td>
        </xpath>

        <!-- SUBTOTAL SIN IVA (mostrando moneda) -->
        <xpath expr="//td[@name='td_product_subtotal']" position="replace">
            <td name="td_product_subtotal" class="text-end o_price_total py-1">
                <t t-if="not line.is_downpayment and not collapse_prices">
                    <span t-esc="(line.price_unit / 1.16) * line.product_uom_qty"
                          t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>
                </t>
            </td>
        </xpath>

        <!-- TOTALES -->
        <xpath expr="//div[@id='total']" position="attributes">
            <attribute name="style">font-size:9px;</attribute>
        </xpath>

        <!-- MONTO TOTAL CON LETRA Y MONEDA -->
        <xpath expr="//div[@name='so_total_summary']" position="after">
            <div style="text-align:right; font-size:10px; margin-top:5px; margin-bottom:5px;">
                <strong>Moneda:</strong> <span t-field="doc.currency_id.name"/><br/>
                <strong>Total con letra:</strong>
                <span t-esc="doc.currency_id.with_context(lang=doc.partner_id.lang or 'es_ES').amount_to_text(doc.amount_total).replace(' M.E.', '') + ' ' + '{:02d}/100'.format(int(round((doc.amount_total % 1) * 100))) + ' ' + doc.currency_id.name"/>
            </div>
        </xpath>

        <!-- NOTAS -->
        <xpath expr="//span[@name='order_note']" position="replace">
            <span t-field="doc.note" name="order_note"
                  t-attf-style="font-size:9px; #{'text-align:justify;text-justify:inter-word;' if doc.company_id.terms_type != 'html' else ''}"/>
        </xpath>

    </template>

</odoo>
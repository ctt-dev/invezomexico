<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Heredar del template de MX EDI -->
        <template id="invoice_llantired" inherit_id="l10n_mx_edi.report_invoice_document" priority="99">
    
            <!-- ====================================================== -->
            <!-- ELIMINAR FECHA LÍMITE, FECHA ENTREGA Y REFERENCIA -->
            <!-- ====================================================== -->
            
            <!-- Eliminar Due Date -->
            <xpath expr="//div[@id='informations']//div[@name='due_date']" position="replace"/>
            
            <!-- Eliminar Delivery Date -->
            <xpath expr="//div[@id='informations']//div[@name='delivery_date']" position="replace"/>
            
            <!-- Eliminar Reference -->
            <!-- <xpath expr="//div[@id='informations']//div[@name='reference']" position="replace"/> -->
            
            <!-- ====================================================== -->
            <!-- ESTILOS GENERALES PARA LA TABLA - MÁS COMPACTA -->
            <!-- ====================================================== -->
            <xpath expr="//table[@name='invoice_line_table']" position="attributes">
                <attribute name="style">
                    width:100%;
                    font-size:6.5pt;
                    table-layout:fixed;
                    border-collapse:collapse;
                    border:1px solid #d9d9d9;
                    margin-bottom:2px !important;
                </attribute>
            </xpath>
            
            <!-- ====================================================== -->
            <!-- AGREGAR COLUMNA SKU (ANTES DEL CÓDIGO SAT) -->
            <!-- ====================================================== -->
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_product_unspsc_code']" position="before">
                <th class="text-center" name="th_sku" style="background:#73A07B; color:white; font-size:6.5pt; font-weight:bold; padding:3px 4px; border:1px solid #5f8a66; text-align:center; vertical-align:middle; width:8%;">
                    <span>SKU</span>
                </th>
            </xpath>
            
            <!-- Cambiar título de "Product code" a "Código SAT" y asegurar fondo -->
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_product_unspsc_code']" position="attributes">
                <attribute name="style">background:#73A07B; color:white; font-size:6.5pt; font-weight:bold; padding:3px 4px; border:1px solid #5f8a66; text-align:center; vertical-align:middle; width:10%;</attribute>
            </xpath>
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_product_unspsc_code']/span" position="replace">
                <span>Código SAT</span>
            </xpath>
            
            <!-- Cambiar título de "Unit code" a "Unidad SAT" y asegurar fondo -->
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_product_uom_unspsc_code']" position="attributes">
                <attribute name="style">background:#73A07B; color:white; font-size:6.5pt; font-weight:bold; padding:3px 4px; border:1px solid #5f8a66; text-align:center; vertical-align:middle; width:8%;</attribute>
            </xpath>
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_product_uom_unspsc_code']/span" position="replace">
                <span>Unidad SAT</span>
            </xpath>
            
            <!-- ====================================================== -->
            <!-- ESTILOS PARA ENCABEZADOS - COMPACTOS -->
            <!-- ====================================================== -->
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_description']" position="attributes">
                <attribute name="style">background:#73A07B; color:white; font-size:6.5pt; font-weight:bold; padding:3px 4px; border:1px solid #5f8a66; text-align:center; vertical-align:middle; width:22%;</attribute>
            </xpath>
            
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_quantity']" position="attributes">
                <attribute name="style">background:#73A07B; color:white; font-size:6.5pt; font-weight:bold; padding:3px 4px; border:1px solid #5f8a66; text-align:center; vertical-align:middle; width:6%;</attribute>
            </xpath>
            
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_priceunit']" position="attributes">
                <attribute name="style">background:#73A07B; color:white; font-size:6.5pt; font-weight:bold; padding:3px 4px; border:1px solid #5f8a66; text-align:center; vertical-align:middle; width:10%;</attribute>
            </xpath>
            
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_discount']" position="attributes">
                <attribute name="style">background:#73A07B; color:white; font-size:6.5pt; font-weight:bold; padding:3px 4px; border:1px solid #5f8a66; text-align:center; vertical-align:middle; width:6%;</attribute>
            </xpath>
            
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_taxes']" position="attributes">
                <attribute name="style">background:#73A07B; color:white; font-size:6.5pt; font-weight:bold; padding:3px 4px; border:1px solid #5f8a66; text-align:center; vertical-align:middle; width:10%;</attribute>
            </xpath>
            
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_subtotal']" position="attributes">
                <attribute name="style">background:#73A07B; color:white; font-size:6.5pt; font-weight:bold; padding:3px 4px; border:1px solid #5f8a66; text-align:center; vertical-align:middle; width:10%;</attribute>
            </xpath>
            
            <!-- Cambiar texto del encabezado Precio -->
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_priceunit']/span" position="replace">
                <span>Precio SIN IVA</span>
            </xpath>
            
            <!-- ====================================================== -->
            <!-- CELDA SKU (DATOS) - COMPACTA -->
            <!-- ====================================================== -->
            <xpath expr="//table[@name='invoice_line_table']//td[@name='td_product_unspsc_code']" position="before">
                <td name="td_sku" class="text-center" style="background:#fafafa; font-size:6.5pt; padding:2px 3px; border-bottom:1px solid #e5e5e5; vertical-align:middle; width:8%;">
                    <span t-field="line.product_id.default_code"/>
                </td>
            </xpath>
            
            <!-- Estilo celdas Código SAT -->
            <xpath expr="//table[@name='invoice_line_table']//td[@name='td_product_unspsc_code']" position="attributes">
                <attribute name="style">background:#fafafa; font-size:6.5pt; padding:2px 3px; border-bottom:1px solid #e5e5e5; vertical-align:middle; text-align:center; width:10%;</attribute>
            </xpath>
            
            <!-- Unidad SAT - Más compacta -->
            <xpath expr="//table[@name='invoice_line_table']//td[@name='td_product_uom_unspsc_code']" position="replace">
                <td name="td_product_uom_unspsc_code" class="text-center" style="background:#fafafa; font-size:6.5pt; padding:2px 3px; border-bottom:1px solid #e5e5e5; vertical-align:middle; width:8%;">
                    <t t-set="unspsc_code" t-value="line._get_uom_unspsc_code()"/>
                    <t t-out="unspsc_code"/>
                    <t t-if="unspsc_code == 'H87'"> Pieza</t>
                    <t t-elif="unspsc_code == 'EA'"> C/U</t>
                    <t t-elif="unspsc_code == 'MTK'"> m²</t>
                    <t t-elif="unspsc_code == 'MTR'"> m</t>
                    <t t-elif="unspsc_code == 'KGM'"> kg</t>
                    <t t-elif="unspsc_code == 'LTR'"> L</t>
                    <t t-elif="unspsc_code == 'C62'"> Unid</t>
                    <t t-elif="unspsc_code == 'BX'"> Caja</t>
                    <t t-elif="unspsc_code == 'DZN'"> Doc</t>
                    <t t-elif="unspsc_code == 'SET'"> Jgo</t>
                    <t t-elif="unspsc_code == 'PR'"> Par</t>
                </td>
            </xpath>
            
            <!-- Descripción - Más compacta -->
            <xpath expr="//table[@name='invoice_line_table']//td[@name='account_invoice_line_name']" position="attributes">
                <attribute name="style">background:#fafafa; font-weight:500; font-size:6.5pt; padding:2px 3px; border-bottom:1px solid #e5e5e5; vertical-align:middle; text-align:left; width:22%;</attribute>
            </xpath>
            
            <!-- Descripción - Mostrar nombre del producto o descripción -->
            <xpath expr="//td[@name='account_invoice_line_name']" position="replace">
                <td name="account_invoice_line_name" t-att-class="padding_class" style="background:#fafafa; font-weight:500; font-size:6.5pt; padding:2px 3px; border-bottom:1px solid #e5e5e5; vertical-align:middle; text-align:left; width:22%;">
                    <t t-if="line.name">
                        <span t-field="line.name" t-options="{'widget': 'text'}" dir="auto"/>
                    </t>
                    <t t-else="">
                        <span t-field="line.product_id.display_name" t-options="{'widget': 'text'}" dir="auto"/>
                    </t>
                    <span t-if="line.l10n_mx_edi_customs_number" style="font-size:6pt; color:#666; display:block; margin-top:1px;">Ped: <span t-esc="line.l10n_mx_edi_customs_number"/></span>
                </td>
            </xpath>
            
            <!-- Impuestos - Más compacto -->
            <xpath expr="//td[@name='td_taxes']" position="replace">
                <td name="td_taxes" t-if="display_taxes" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}" style="background:#fafafa; font-size:6.5pt; padding:2px 3px; border-bottom:1px solid #e5e5e5; vertical-align:middle; width:10%;">
                    <span t-if="not hide_prices" t-out="taxes" id="line_tax_ids">15%</span>
                </td>
            </xpath>
            
            <!-- Cantidad + Unidad comercial - Más compacta -->
            <xpath expr="//table[@name='invoice_line_table']//td[@name='td_quantity']" position="attributes">
                <attribute name="style">background:#fafafa; font-size:6.5pt; padding:2px 3px; border-bottom:1px solid #e5e5e5; vertical-align:middle; text-align:center; width:6%;</attribute>
            </xpath>
            
            <!-- Precio Unitario SIN IVA - Más compacto -->
            <xpath expr="//table[@name='invoice_line_table']//td[@name='td_price_unit']" position="replace">
                <td name="td_price_unit" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" style="background:#fafafa; font-size:6.5pt; padding:2px 3px; border-bottom:1px solid #e5e5e5; vertical-align:middle; width:10%;">
                    <span t-if="not hide_prices">
                        <t t-set="tax_rate" t-value="0.0"/>
                        <t t-foreach="line.tax_ids" t-as="tax">
                            <t t-if="tax.amount_type == 'percent'">
                                <t t-set="tax_rate" t-value="tax_rate + tax.amount"/>
                            </t>
                        </t>
                        <t t-set="price_without_tax" t-value="line.price_unit / (1 + (tax_rate / 100)) if tax_rate else line.price_unit"/>
                        <t t-esc="'{:,.2f}'.format(price_without_tax)"/>
                    </span>
                </td>
            </xpath>
            
            <!-- Subtotal - Más compacto -->
            <xpath expr="//table[@name='invoice_line_table']//td[@name='td_subtotal']" position="attributes">
                <attribute name="style">background:#fafafa; font-size:6.5pt; padding:2px 3px; border-bottom:1px solid #e5e5e5; vertical-align:middle; text-align:end; width:10%;</attribute>
            </xpath>
            
            <!-- Descuento - Si existe, más compacto -->
            <xpath expr="//table[@name='invoice_line_table']//td[@name='td_discount']" position="attributes">
                <attribute name="style">background:#fafafa; font-size:6.5pt; padding:2px 3px; border-bottom:1px solid #e5e5e5; vertical-align:middle; text-align:center; width:6%;</attribute>
            </xpath>
            
            <!-- ====================================================== -->
            <!-- SECCIÓN DE INFORMACIÓN - TAMAÑO REDUCIDO -->
            <!-- ====================================================== -->
            <xpath expr="//div[@id='informations']" position="attributes">
                <attribute name="style">font-size:10px !important; line-height:1.3; margin-bottom:5px;</attribute>
            </xpath>
            
            <!-- Agregar Moneda -->
            <xpath expr="//div[@id='informations']" position="inside">
                <div class="col" style="font-size:10px;">
                    <strong>Moneda:</strong>
                    <span t-esc="o.currency_id.name"/>
                </div>
            </xpath>
            
            <!-- Tipo de Cambio después de informaciones -->
            <xpath expr="//div[@id='informations']" position="after">
                <div class="row mb-1" t-if="o.currency_id.name == 'USD'" style="font-size:10px;">
                    <div class="col">
                        <strong>Tipo de Cambio:</strong>
                        <span t-esc="'%.6f' % (o.exchange_rate or 0.0)"/>
                    </div>
                </div>
            </xpath>

            <!-- MONTOS EN LETRA - CON MÉTODO PERSONALIZADO Y MÁS COMPACTO -->
            <xpath expr="//p[hasclass('text-end', 'lh-sm')]" position="replace">
                <p class="text-end lh-sm" style="font-size:11px; text-align:right; margin-bottom:2px;">
                    <strong>Total en letra:</strong><br/>
                    <span style="font-size:10pt;" t-out="o._get_amount_words_clean()"/>
                </p>
            </xpath>
            
            <!-- ====================================================== -->
            <!-- TABLA DE TOTALES - REDUCIR TAMAÑO -->
            <!-- ====================================================== -->
            <xpath expr="//div[@id='total']" position="attributes">
                <attribute name="style">font-size:11px !important; line-height:1.1; margin-top:3px;</attribute>
            </xpath>
            
            <!-- ====================================================== -->
            <!-- DATOS BANCARIOS - MÁS COMPACTOS -->
            <!-- ====================================================== -->
            <xpath expr="//p[@name='payment_communication']" position="inside">
                <div class="row mt-1" style="width:35%; font-size:7pt;">
                    <div class="col-12">
                        <div t-if="o.move_type == 'out_invoice' and o.state == 'posted'" style="border:1px solid #d9d9d9; margin-bottom:4px;">
                            <div style="background:#73A07B; color:white; padding:2px 4px; font-weight:bold; font-size:7pt;">
                                DATOS PARA TRANSFERENCIA BANCARIA
                            </div>
                            <table style="width:100%; font-size:6.5pt; border-collapse:collapse;">
                                <tbody>
                                    <tr>
                                        <td style="padding:1px 3px; width:25%;"><strong>BANCO:</strong></td>
                                        <td style="padding:1px 3px;">
                                            <t t-if="o.currency_id.name == 'USD'">BANORTE (DÓLARES)</t>
                                            <t t-else="">HSBC</t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:1px 3px;"><strong>CONCEPTO:</strong></td>
                                        <td style="padding:1px 3px;">
                                            <span t-field="o.payment_reference" t-options="{'widget': 'text'}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:1px 3px;"><strong>CLABE:</strong></td>
                                        <td style="padding:1px 3px;">
                                            <t t-if="o.company_id.name == 'LLANTIRED' and o.currency_id.name == 'MXN'">
                                                021743040678913582
                                            </t>
                                            <t t-elif="o.company_id.name == 'LLANTIRED' and o.currency_id.name == 'USD'">
                                                072731013015735748
                                            </t>
                                            <t t-elif="o.company_id.name == 'LA BODEGA LLANTAS Y ACCESORIOS' and o.currency_id.name == 'MXN'">
                                                021743040189731499
                                            </t>
                                            <t t-elif="o.company_id.name == 'LA BODEGA LLANTAS Y ACCESORIOS' and o.currency_id.name == 'USD'">
                                                021743070004580915
                                            </t>
                                            <t t-elif="o.company_id.name == 'A-DRONE'">
                                                072731011952302184
                                            </t>
                                            <t t-else="">
                                                <span t-field="o.company_id.bank_ids.acc_number"/>
                                            </t>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </xpath>
            
            <!-- Estilo comentarios más compactos -->
            <xpath expr="//div[@name='comment']" position="attributes">
                <attribute name="style">font-size:7pt !important; line-height:1.1 !important; margin-bottom:1px !important; text-align:justify;</attribute>
            </xpath>
    
        </template>
    </data>
</odoo>
<odoo>
    <data>
        <record id="partner_credit_limit_inherit_view_form_inherit" model="ir.ui.view">
            <field name="name">res_partner_inherit_view_credit_limit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                 <xpath expr="//page[@name='sales_purchases']" position="after">
                    <page name="credit" string="Credito">
                        <group name="credit" String="Credito" position="inside">
                            <field name="show_credit_limit" string="Mostrar limite de credito" readonly="0" invisible="1"/>
                            <!-- <field name="credit_used" string="Crédito usado"/> !-->
                            <!-- <field name="aplazo_actual" readolony="1"/> !-->
                            <field name="credit" string="Total vencido"/>
                            <field name="credit_used" />
                            <field name="active_limit" string="Activar Limites de Credito" attrs="{'readonly': [('can_block_credit', '!=', True)]}"/>
                            <field name="warning_stage" attrs="{'readonly':[('active_limit', '!=', True),('can_block_credit','!=',True)]}"/>
                            <field name="blocking_stage" attrs="{'readonly':[('active_limit', '!=', True),('can_block_credit','!=',True)]}"/>
                            <field name="can_block_credit" invisible="1"/>
                            <field name="can_make_aplazo" invisible="1"/>
                            <field name="compute_limit" invisible="1"/>
                            <field name="message_blocked_credit" attrs="{'readonly': [('can_block_credit', '!=', True)]}"/>
                        </group>
                        <group string="Sales" name="sale" priority="1">
                            <field name="property_supplier_payment_term_id"/>
                        </group>
                        <group string="Purchase" name="purchase" priority="2">
                            <field name="property_payment_term_id"/>
                        </group>
                    </page>
                    <page name="aplazos" string="Convenio de Deuda" >
                        <field name="postponements" nolabel="1"  attrs="{'readonly':[('can_make_aplazo', '!=', True)]}">
                            <tree string="Aplazos" editable="top" deletable="true">
                                <field name="partner" invisible="1"/>
                                <field name="limit_date"/>
                                <field name="authorized"/>
                                <field name="request"/>
                                <field name="motive"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
                <xpath expr="//field[@name='vat']" position="after">
                    <field name="required_oc" string="Se requiere orden de compra?"/>
                    <field name="deny_credit" attrs="{'readonly': [('can_block_credit', '!=', True)]}"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>


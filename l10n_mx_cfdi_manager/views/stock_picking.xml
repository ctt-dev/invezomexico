<odoo>
    <data>
        <record id="view_picking_form" model="ir.ui.view">
            <field name="name">stock.picking.form.inherit.l10n_mx_cfdi_manager</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="active">1</field>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="asignar_cfdi" string="Vincular CFDI" class="oe_highlight" type="object" invisible="cfdi_document != False or picking_type_code != 'incoming' or state != 'done'"/>
                    <button name="unlink_cfdi" string="Desvincular CFDI" class="oe_highlight" type="object" confirm="¿Está seguro que desea desvincular el CFDI?" invisible="cfdi_document == False or picking_type_code != 'incoming' or state != 'done'"/>
                </xpath>
                <xpath expr="//sheet//group//group[2]" position="inside">
                    <!-- <label for="cfdi_document" invisible="cfdi_document == False"/> -->
                    <field name="cfdi_document" options="{'no_create': True}" readonly="1" save_force="1" invisible="cfdi_document == False"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
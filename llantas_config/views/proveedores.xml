<odoo>
    <data>
        <record id="view_proveedores_tree" model="ir.ui.view">
            <field name="name">Proveedores</field>
            <field name="model">llantas_config.ctt_prov</field>
            <field name="arch" type="xml">
                <list edit="0" sample="1">
                    <field name="nombre_proveedor" />
                    <field name="partner_id" />
                    <field name="sku" />
                    <field name="sku_interno" />
                    <field name="producto" />
                    <field name="marca" optional="hide"/>
                    <field name="modelo" optional="hide"/>
                    <field name="medida" optional="hide"/>
                    <field name="indice_carga" optional="hide"/>
                    <field name="indice_velocidad" optional="hide"/>
                    <field name="ancho" optional="hide"/>
                    <field name="alto" optional="hide"/>
                    <field name="rin" optional="hide"/>
                    <field name="nombre_almacen" />       
                    <field name="existencia" />
                    <!-- <field name="product_id_qty_available" /> -->
                    <field name="costo_sin_iva" />
                    <field name="tipo_moneda" optional="show"/>
                    <field name="tipo_cambio" optional="hide"/>
                    <field name="precio_lista" />
                    <field name="precio_llantired" />
                    <field name="precio_promocion" />
                    <field name="tipo_moneda" optional="hide"/>
                    <field name="tipo_cambio" optional="hide"/>
                    <field name="fecha_actualizacion" optional="hide"/>
                    <field name="create_date" optional="hide"/>
                    <field name="subalmacenes" optional="hide" />
                    <field name="procesado" invisible="0"/>
                    
                </list>
            </field>
        </record>

        <record id="ctt_llantas_action_ctrl_proveedores_form" model="ir.ui.view">
            <field name="name">form</field>
            <field name="model">llantas_config.ctt_prov</field>
            <field name="arch" type="xml">
            <form string="Resumen">
                <sheet string="Registration">
                    <div class="oe_button_box" />
                    <group>
                        <group string="Producto" >
                            <field name="sku" />
                            <field name="codigo_producto" />
                            <field name="nombre_proveedor" />
                            <field name="producto" />
                            <!-- <field name="almacen" />        -->
                            
                        </group>
                        <group string="Información proveedor" >
                            <field name="almacen" />       
                            <field name="existencia" />
                            <field name="costo_sin_iva" />
                            <field name="tipo_moneda" />
                            <field name="tipo_cambio" />
                            <field name="procesado" invisible="1"/>
                        </group>
                        <group string="Informacion registro" >
                            <!-- <field name="fecha_registro" optional="hide"/> -->
                            <field name="fecha_proveedor"/>
                            
                        </group>
                    </group>
                </sheet>
                 <div class="oe_chatter">
                        <!-- <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/> -->
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
            </form>
            </field>
        </record>


        <record id="ctt_llantas_action_proveedor_list_form" model="ir.actions.act_window">
            <field name="name">Existencia proveedores</field>
            <field name="res_model">llantas_config.ctt_prov</field>
            <field name="view_mode">list,form,pivot</field>
            <field name="context">{'create': True}</field>
            <field name="target">main</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_empty_folder">
                    No hay registros
                </p><p>
                    Aqui aparecerán los registros de existencia de proveedores.
                </p>
            </field>
        </record>

        <record id="llantas_config_proveedor_list_search" model="ir.ui.view">
            <field name="name">Buscar</field>
            <field name="model">llantas_config.ctt_prov</field>
            <field name="arch" type="xml">
               <search string="Buscar">
                   <field name="codigo_producto" string="Producto" filter_domain="['|', '|', '|', '|', '|',
                        ('codigo_producto', 'ilike', self),
                        ('sku', 'ilike', self),
                        ('producto', 'ilike', self),
                        ('marca', 'ilike', self),
                        ('modelo', 'ilike', self),
                        ('medida', 'ilike', self)
                    ]" />

                    <field name="nombre_proveedor" string="Proveedor" filter_domain="[('nombre_proveedor', 'ilike', self)]"/>
                    <field name="nombre_almacen" string="Almacen" filter_domain="[('almacen', 'ilike', self)]"/>
                    <field name="sku" string="Sku" filter_domain="['|',('sku', 'ilike', self),('sku_interno', 'ilike', self)]"/>
                    <field name="marca" filter_domain="[('marca', 'ilike', self)]"/>
                    <field name="modelo" filter_domain="[('modelo', 'ilike', self)]"/>
                    <field name="medida" filter_domain="[('medida', 'ilike', self)]"/>
                    <field name="indice_carga" filter_domain="[('indice_carga', 'ilike', self)]"/>
                    <field name="indice_velocidad" filter_domain="[('indice_velocidad', 'ilike', self)]"/>
                    <field name="ancho" filter_domain="[('ancho', 'ilike', self)]"/>
                    <field name="alto" filter_domain="[('alto', 'ilike', self)]"/>
                    <field name="rin" filter_domain="[('rin', 'ilike', self)]"/>
                    

                   <filter string="Productos con existencias" name="existencia" domain="[('existencia', '>', 0)]"/>
                   <filter string="Costo en cero" name="costo_sin_iva" domain="[('costo_sin_iva', '=', 0)]"/>
               
                    <separator/>
                   <group expand="0" string="Group By">
                    <filter string="Proveedor" name="nombre_proveedor" domain="[]" context="{'group_by': 'nombre_proveedor'}"/>
                    <!-- <filter name="marketplace" string="Marketplace" domain="[]" context="{'group_by': 'marketplace'}"/> -->
                    <filter string="Almacen" name="nombre_almacen" domain="[]" context="{'group_by': 'nombre_almacen'}"/>
                    <filter string="Producto" name="producto" domain="[]" context="{'group_by': 'producto'}"/>
                    <filter string="Sku" name="sku" domain="[]" context="{'group_by': 'sku'}"/>
                       
                       
                    </group>
                       
                </search>
            </field>
        </record>

        <record id="tree_view_proveedores_links" model="ir.ui.view">
            <field name="name">link.Proveedores</field>
            <field name="model">llantas_config.proveedores_links</field>
            <field name="arch" type="xml">
                <list string="Status" editable="top">
                    <field name="name"/>
                    <field name="proveedor_id"/>
                    <field name="url" />
                    <field name="company_id" />
                    <field name="color" widget="color_picker" required="0"/>
                    <button name="process_link" string="Descargar existencias" type="object" class="btn-info" invisible="not url"/>
                    <button name="action_open_modal" string="Procesar" type="object" class="btn-success" invisible="not proveedor_id" context="{'default_proveedores_links_id':active_id}"/>
                    <button name="procesar_concentrado" string="Descargar concentrado" type="object" class="btn-info" />
                    <button name="procesar_supplierinfo" string="Procesar concentrado" type="object" class="btn-info" />
                    <field name="query_create" optional="hide" invisible="name != 'Concentrado'"/>
                    <field name="query_update" optional="hide" invisible="name != 'Concentrado'"/>
                    <field name="query_delete" optional="hide" invisible="name != 'Concentrado'"/>
                    <field name="porcentaje" widget="progress_bar" optional="hide" invisible="name != 'Concentrado'"/>
                    <field name="obteniendo_datos" optional="hide" invisible="name != 'Concentrado'"/>
                    <field name="query_insert_descargas" invisible="0" optional="hide"/>
                    <field name="query_update_descargas" invisible="0" optional="hide"/>
                    <field name="procesar_descargas" invisible="0" optional="hide"/>
                    
                    
                </list>
            </field>
        </record>
        

        <record id="view_product_template_pos_form" model="ir.ui.view">
            <field name="name">sales.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                
                 <xpath expr="//group[@name='order_details']//field[@name='payment_term_id']" position="after">
                    
                     <field name="comprador_id" domain="['|',('category_ids','ilike','COMP'),('category_ids','ilike','Comp')]" readonly="state in ('done','cancel')"/> 
                     <field name="ventas_status" widget="selection"/>
                    <field name="mostrar_comision" invisible="1"/>
                     <field name="mostrar_envio" invisible="1"/>
                     <field name="comision" invisible="not mostrar_comision"/>


                     <field name="envio" invisible="not mostrar_envio"/>
                     <field name="warehouse_id" options="{'no_create': True}" />
                     <field name="auto_warehouse_id" invisible="0" />
                     <field name="is_check" invisible="1" readonly="1"/>
                     <field name="disponibilidad_verificada" invisible="1" readonly="1"/>
                     <label for="revisar_disponibilidad" />
                     <div class="o_row">
                        <button name="revisar_disponibilidad" type="object" string="Revisar disponibilidad" class="btn-primary" invisible="state != 'draft'"/>
                     </div>

                     
                     <field name="commitment_date"/>
                     <field name="tipo_factura" />
                     <field name="es_killer" invisible="1"/>
                     <field name="json_data" invisible="1"/>
                     <field name="fee_import" readonly="1"/>
                     <field name="fee_sale" readonly="1" />
                     <field name="ganancia" invisible="1"/>
                     <field name="margin_percent" invisible="1"/>
                     <!-- <field name="status_venta" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/> -->
                 </xpath>
                <xpath expr="//sheet//group[@name='sale_header']" position="before">
                    <div class="oe_title">
                        <group string="Información general">
                            <field name="marketplace" string="Canal de venta" options="{'no_create_edit': True}"/>
                            <field name="link_venta" widget="url" invisible="not (mostrar_comision and mostrar_envio) or es_venta_directa"/>
                            <field name="folio_venta" invisible="not (mostrar_comision and mostrar_envio) or es_venta_directa"/>
                            <!-- <field name="yuju_pack_id" readonly="1" invisible="not mostrar_comision and not mostrar_envio"/> -->
                            <field name="link_facturacion" widget="url" invisible="not (mostrar_comision and mostrar_envio) or es_venta_directa"/>
                             <field name="fecha_venta" invisible="not (mostrar_comision and mostrar_envio) or es_venta_directa"/>
                            <!-- <field name="invoice_id" invisible="1"/> -->
                        </group>
                             
                    </div>
                </xpath>
                <xpath expr="//page[@name='order_lines']//list//field[@name='price_unit']" position="before">
                    <field name="proveedor_id" domain="[('product_tmpl_id','=',product_template_id)]" style="background-color: yellow;" optional="hide" />
                    <field name="costo_proveedor" readonly="1" optional="show" invisible="1" />
                    <field name="costo_proveedor_2" string="Costo proveedor" readonly="1" optional="hide"  />
                    <field name="costo_promedio_historico" readonly="1" invisible="1" optional="hide"/>
                    <field name="costo_promedio" readonly="1" optional="hide"/>
                    <field name="codigo_proveedor" invisible="1" optional="hide" />
                    <field name="is_killer" readonly="1" optional="hide" />
                    <field name="killer_id" widget="many2one" invisible="1" optional="hide"/>
                    <!-- <field name="killer_id_killer_price" invisible="not is_killer" readonly="1" optional="show"/>
                    <field name="killer_id_base_price" invisible="not is_killer" readonly="1" optional="show"/>
                    <field name="killer_id_promotion_price" invisible="not is_killer" readonly="1" optional="show"/> -->
                    <field name="killer_id_killer_price" readonly="1" optional="hide"/>
                    <field name="killer_id_base_price" readonly="1" optional="hide"/>
                    <field name="killer_id_promotion_price" readonly="1" optional="hide"/>
                    
                    
                    
                        <!-- domain="[('product_tmpl_id','=',productos_proveedor)]"/> -->
                </xpath>
                <xpath expr="//page[@name='order_lines']//list//field[@name='price_unit']" position="after">
                    <field name="importe_descuento" optional="show"  />
                    <field name="precio_antes_dec" optional="show" readonly="1" />
                    <field name="ganancia" widget="monetary" optional="hide"/>
                    <field name="margin_percent" widget="percent" optional="hide"/>
                    
                    <!-- <field name="t1" optional="hide"/>
                    <field name="t1_porcentaje" optional="hide"/>
                    <field name="t2" optional="hide"/>
                    <field name="t2_porcentaje" optional="hide"/>
                    <field name="t3" optional="hide"/>
                    <field name="t3_porcentaje" optional="hide"/> -->
                </xpath>
                <xpath expr="//header" position="inside">
                    <button name="create_purchase_for_sale_order" type="object" string="Crear compra" class="btn-secondary" />
                </xpath>
                <xpath expr="//page[@name='other_information']" position="after">
                    <page string="Envio">
                        <group>
                            <!-- <field name="detailed_info" readonly="0" widget="html" invisible="state in ('draft', 'send')"/> -->
                            <field name="traspaso_name" readonly="1"/>
                            <field name="llantas_config_carrier_id"/>
                            <field name="guia" readonly="0"/>
                            <field name="link_guia" readonly="0" widget="url"/>
                            <field name="estado_traspaso" readonly="1"/>
                        </group>
                    </page>
                </xpath>
                <xpath expr="//field[@name='tax_totals']" position="after">
                    <label for="ganancia" groups="base.group_user"/>
                    <div class="text-nowrap" groups="base.group_user">
                        <!-- Mostrar el campo de ganancia como monetario -->
                        <field name="ganancia" class="oe_inline" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                
                        <!-- Mostrar el porcentaje de margen, solo si hay un valor no nulo -->
                        <span class="oe_inline" invisible="ganancia == 0">
                            (<field name="margin_percent" nolabel="1" class="oe_inline" widget="float" options="{'precision': 1}"/>%)
                        </span>
                    </div>
                </xpath>

                <xpath expr="//page[@name='order_lines']//list//field[@name='product_uom_qty']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
                
                <xpath expr="//page[@name='order_lines']//list//field[@name='qty_delivered']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
                
                <xpath expr="//page[@name='order_lines']//list//field[@name='qty_invoiced']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
                
                <xpath expr="//page[@name='order_lines']//list//field[@name='product_uom_id']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
                
                <xpath expr="//page[@name='order_lines']//list//field[@name='price_unit']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
                
                <xpath expr="//page[@name='order_lines']//list//field[@name='tax_ids']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
                
                <xpath expr="//page[@name='order_lines']//list//field[@name='discount']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
                
                <xpath expr="//page[@name='order_lines']//list//field[@name='customer_lead']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
                
                <!-- También puedes modificar los campos de precio subtotal/total -->
                <xpath expr="//page[@name='order_lines']//list//field[@name='price_subtotal']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
                
                <xpath expr="//page[@name='order_lines']//list//field[@name='price_total']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>

                
            </field>
        </record>

        <record id="view_sale_order_tree_view" model="ir.ui.view">
            <field name="name">sale_order_tree_view</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list//field[@name='name']" position="before">
                    <field name="marketplace_name" />
                    
                    <field name="folio_venta" optional="show"/>
                    <!-- <field name="yuju_pack_id" optional="hide" /> -->
                    <field name="fecha_venta" optional="hide" />
                    <field name="comprador_id" widget="many2one" optional="show"/>
                    
                    <field name="status_ventas" widget="many2one_tags" />
                        <!-- domain="[('product_tmpl_id','=','order_line.product_template_id')]"/> -->
                </xpath>
                <field name="amount_total" position="after">
                    <field name="ganancia" widget="monetary" optional="hide"/>
                    <field name="margin_percent" widget="percent" optional="hide"/>
                </field>
                <field name="user_id" position="replace">
                    <field name="user_id" widget="many2one_avatar_user" optional="show" string="Usuario"/>
                </field>
            </field>
        </record>
        <record id="view_sale_order2_tree_view" model="ir.ui.view">
            <field name="name">sale_order2_tree_view</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list//field[@name='name']" position="before">
                    <field name="marketplace_name" />
                    <field name="yuju_pack_id"/>
                    
                    <!-- <field name="folio_venta" optional="show"/> -->
                    <!-- <field name="yuju_pack_id" optional="hide" /> -->
                    <field name="fecha_venta" optional="hide" />
                    <field name="comprador_id" widget="many2one" optional="show"/>
                    <field name="status_ventas" widget="many2one_tags" />
                    
                        <!-- domain="[('product_tmpl_id','=','order_line.product_template_id')]"/> -->
                </xpath>
                <field name="amount_total" position="after">
                    <field name="ganancia" widget="monetary" optional="hide"/>
                    <field name="margin_percent" widget="percent" optional="hide"/>
                </field>
                <field name="user_id" position="replace">
                    <field name="user_id" widget="many2one_avatar_user" optional="show" string="Usuario"/>
                </field>
            </field>
        </record>
        
        <record id="view_sale_order3_tree_view" model="ir.ui.view">
            <field name="name">sale_order3_tree_view</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.sale_order_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list//field[@name='name']" position="before">
                  
                    <field name="folio_venta" optional="show"/>
                  
                </xpath>
               
            </field>
        </record>




        <record id="view_sale_order_search_inherit" model="ir.ui.view">
            <field name="name">sale_order_seach_inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_sales_order_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search//field[@name='user_id']" position="before">
                    <field name="yuju_pack_id"/>
                </xpath>
                <xpath expr="//search//group//filter[@name='salesperson']" position="after">
                    <filter name="marketplace_name" string="Marketplace" domain="[]" context="{'group_by': 'marketplace_name'}"/>
                    
                </xpath>
                <xpath expr="//search//filter[@name='my_sale_orders_filter']" position="after">
                    <filter name="es_killer" string="Es venta killer" domain="[('es_killer', '=', True)]"/>
                    <filter string="Fecha de venta" name="fecha_venta" date="fecha_venta"/>
                    
                </xpath>
                <xpath expr="//search//group//filter[@name='order_month']" position="after">
                    <filter string="Fecha de venta" name="fecha_venta" domain="[]" context="{'group_by': 'fecha_venta'}"/>
                    <filter string="Comprador" name="comprador_id" domain="[]" context="{'group_by': 'comprador_id'}"/>
                    
                </xpath>
                <field name="name" position="replace" >
                    <field name="name" string="Order" filter_domain="['|', '|','|', ('name', 'ilike', self), ('client_order_ref', 'ilike', self), ('partner_id', 'child_of', self), ('folio_venta', 'ilike', self)]"/>
                    <field name="folio_venta" />
                </field>
                <!-- <xpath expr="//search//field[@name='name']" position="replace">
                    <field name="name" string="Order" filter_domain="['|', '|', '|', '|', ('name', 'ilike', self),('folio_venta', 'ilike', self), ('client_order_ref', 'ilike', self), ('partner_id', 'child_of', self), ('yuju_pack_id', 'ilike', self)]"/>
                </xpath> -->
            </field>
        </record>

        
        <record id="sale_margin.sale_margin_sale_order" model="ir.ui.view">
            <field name="active">False</field>
        </record>
        
       
       
        

    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_form_view_inherit" model="ir.ui.view">
        <field name="name">pos.config.form.view.inherit</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='other_devices']" position="before">
                <div class="col-12 col-lg-6 o_setting_box" id="other_devices">
                        <div class="o_setting_left_pane">
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="approbation_employee_ids" string="Empleados con permiso a autorizar credito/descuento" class="col-lg-3 o_light_label" />
                            <field name="approbation_employee_ids" widget="many2many_tags" domain="[('company_id', '=', company_id)]" />
                                <div class="text-muted mb16">
                                    Usuarios con permiso para aprobar créditos y descuentos
                                </div>
                        </div>
                    </div>
            </xpath>
        </field>
    </record>
</odoo>

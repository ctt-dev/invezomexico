<odoo>
    <data>
        <record id="view_stock_picking_validate_wizard" model="ir.ui.view">
            <field name="name">stock.picking.validate.wizard.form</field>
            <field name="model">stock.picking.validate.wizard</field>
            <field name="arch" type="xml">
                <form string="Confirmar validación">
                    <group>
                        <p>
                            ¿Deseas validar los movimientos seleccionados?
                        </p>
                    </group>
        
                    <footer>
                        <button name="action_confirm_validate"
                                string="Validar"
                                type="object"
                                class="btn-primary"/>
        
                        <button string="Cancelar"
                                special="cancel"
                                class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>

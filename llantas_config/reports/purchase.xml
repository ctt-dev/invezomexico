<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================================================== -->
    <!-- PURCHASE STOCK -->
    <!-- ====================================================== -->

    <template id="purchase_stock_report_purchaseorder_document_for_llantas"
              inherit_id="purchase_stock.report_purchaseorder_document">

        <!-- Eliminar shipping -->
        <xpath expr="//t[@t-else='']"
               position="replace"/>

    </template>


    <!-- ====================================================== -->
    <!-- PURCHASE ORDER -->
    <!-- ====================================================== -->

    <template id="purchase_report_purchaseorder_document_for_llantas"
              inherit_id="purchase.report_purchaseorder_document">


        <!-- ================================================== -->
        <!-- ADDRESS -->
        <!-- ================================================== -->

        <xpath expr="//t[@t-set='address']"
               position="replace">

            <t t-set="address">

                <div t-field="o.partner_id"
                     t-options="{
                        'widget': 'contact',
                        'fields': ['address', 'name'],
                        'no_marker': True
                     }"/>

                <div t-if="o.partner_id.vat">

                    <strong>

                        <t t-if="o.company_id.country_id.vat_label"
                           t-esc="o.company_id.country_id.vat_label"/>

                        <t t-else="">RFC</t>

                    </strong>:

                    <span t-field="o.partner_id.vat"/>

                </div>

                <div t-if="o.partner_id.phone">

                    <strong>Teléfono:</strong>

                    <span t-field="o.partner_id.phone"/>

                </div>

            </t>

        </xpath>


        <!-- ================================================== -->
        <!-- HEADER EXTRA -->
        <!-- ================================================== -->

        <xpath expr="//div[hasclass('page')]"
               position="inside">

            <div class="row mb-4">

                <div class="col-5">

                    <strong>
                        NOTA IMPORTANTE:
                    </strong>

                    Este número de Orden de Compra debe aparecer
                    en toda factura, conocimiento de embarque,
                    guía de transporte, nota de remisión
                    y correspondencia relacionada.

                </div>

            </div>

            <div class="row mb-4">

                <!-- ORDEN VENTA -->
                <div class="col-3"
                     t-if="o.auto_sale_order_id.name">

                    <strong>Orden de venta:</strong>

                    <p class="m-0"
                       t-field="o.auto_sale_order_id.name"/>

                    <p class="m-0"
                       t-field="o.auto_sale_order_id.folio_venta"/>

                </div>

                <!-- FECHA VENTA -->
                <div class="col-3"
                     t-if="o.auto_sale_order_id.fecha_venta">

                    <strong>Fecha venta:</strong>

                    <p class="m-0"
                       t-field="o.auto_sale_order_id.fecha_venta"/>

                </div>

                <!-- USER -->
                <div class="col-3"
                     t-if="o.user_id">

                    <strong>Pedido por:</strong>

                    <p class="m-0"
                       t-field="o.user_id"/>

                </div>

                <!-- REFERENCIA -->
                <div class="col-3"
                     t-if="o.partner_ref">

                    <strong>Referencia proveedor:</strong>

                    <p class="m-0"
                       t-field="o.partner_ref"/>

                </div>

            </div>

        </xpath>


        <!-- ================================================== -->
        <!-- INFORMATIONS -->
        <!-- ================================================== -->

        <xpath expr="//div[@id='informations']"
               position="inside">

            <!-- FECHA ORDEN -->
            <div class="col-3"
                 t-if="o.state in ['purchase','done'] and o.date_approve">

                <strong>Fecha orden:</strong>

                <p class="m-0"
                   t-field="o.date_approve"/>

            </div>

            <!-- FECHA LIMITE -->
            <div class="col-3"
                 t-if="o.date_order">

                <strong>Fecha límite:</strong>

                <p class="m-0"
                   t-field="o.date_order"/>

            </div>

        </xpath>


        <!-- ================================================== -->
        <!-- TABLE STYLE -->
        <!-- ================================================== -->

        <xpath expr="//table[contains(@class,'table')]"
               position="attributes">

            <attribute name="style">
                font-size:12px;
            </attribute>

        </xpath>


        <!-- ================================================== -->
        <!-- TABLE HEAD -->
        <!-- ================================================== -->

        <xpath expr="//table[contains(@class,'table')]/thead"
               position="replace">

            <thead>

                <tr>

                    <th class="text-center">
                        Cant.
                    </th>

                    <th class="text-center">
                        Unidad
                    </th>

                    <th class="text-center">
                        Código
                    </th>

                    <th class="text-center">
                        Código proveedor
                    </th>

                    <th>
                        Descripción
                    </th>

                    <th class="text-center">
                        Precio unitario
                    </th>

                    <th class="text-center">
                        Impuestos
                    </th>

                    <th class="text-center">
                        Importe
                    </th>

                </tr>

            </thead>

        </xpath>


        <!-- ================================================== -->
        <!-- TABLE BODY -->
        <!-- ================================================== -->

        <xpath expr="//table[contains(@class,'table')]/tbody"
               position="replace">

            <tbody>

                <t t-foreach="o.order_line"
                   t-as="line">
            
                    <tr>
            
                        <!-- CANTIDAD -->
                        <td class="text-center">
                            <span t-field="line.product_qty"/>
                        </td>
            
                        <!-- UNIDAD -->
                        <td class="text-center">
                            <span t-field="line.product_uom_id"/>
                        </td>
            
                        <!-- CODIGO -->
                        <td class="text-center">
                            <span t-field="line.product_id.default_code"/>
                        </td>
            
                        <!-- CODIGO PROVEEDOR -->
                        <td class="text-center">
                            <span t-field="line.codigo_proveedor"/>
                        </td>
            
                        <!-- DESCRIPCION -->
                        <td>
                            <span t-field="line.name"/>
                        </td>
            
                        <!-- PRECIO -->
                        <td class="text-center">
                            <span t-field="line.price_unit"/>
                        </td>
            
                        <!-- IMPUESTOS -->
                        <td class="text-center">
                            <span t-esc="', '.join(line.tax_ids.mapped('name'))"/>
                        </td>
            
                        <!-- IMPORTE -->
                        <td class="text-center">
                            <span t-field="line.price_subtotal"/>
                        </td>
            
                    </tr>
            
                </t>
            
            </tbody>

        </xpath>


        <!-- ================================================== -->
        <!-- TOTAL + NOTES -->
        <!-- ================================================== -->

        <xpath expr="//div[@id='total']"
               position="after">

            <!-- IMPORTE CON LETRA -->
            <div class="mt-4">

                <h5>
                    Importe con letra
                </h5>

                <span style="font-size:10pt;"
                      t-esc="o.currency_id.with_context(
                            lang=o.partner_id.lang or 'es_ES'
                      ).amount_to_text(o.amount_total)"/>

            </div>

            <!-- NOTAS -->
            <div class="mt-4"
                 t-if="o.note">

                <table class="table table-sm">

                    <tr>

                        <th width="25%">
                            Referencia proveedor
                        </th>

                        <td>

                            <span t-field="o.note"/>

                        </td>

                    </tr>

                </table>

            </div>

        </xpath>

    </template>

</odoo>
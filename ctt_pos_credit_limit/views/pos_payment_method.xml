<odoo>
    <data>
        <record id="pos_payment_method_credit_limit_inherit_view_form_inherit" model="ir.ui.view">
            <field name="name">pos_payment_method_inherit_view_credit_limit</field>
            <field name="model">pos.payment.method</field>
            <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
            <field name="arch" type="xml">
                 <xpath expr="//field[@name='split_transactions']" position="after">
                    <field name="is_credit"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
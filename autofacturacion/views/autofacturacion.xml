<odoo>
    <template id="portal_auto_invoices" name="Autofacturador">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-if="breadcrumbs_searchbar">
                <t t-call="portal.portal_breadcrumbs"/>
            </t>

            <div id="wrap" class="oe_website_login_container">
                <div class="container mb64 col-12">
                    <form id="invoiceForm" action="/AUTOFACTURA/address" method="post" class="oe_login_form" style="max-width: 600px !important;">
                        <h2 class="page-header text-center">Generación de Factura Electrónica</h2>
                        <br/>
                        <t t-if="error">
                            <h4 class="page-header text-center text-danger">
                                El número de pedido o el monto ingresado no coinciden. Por favor, inténtelo de nuevo.
                            </h4>
                        </t>

                        <!-- Número de Referencia -->
                        <div class="form-group col-12">
                            <label class="control-label" for="order">
                                Verifique que el número de venta coincida con el que aparece en el documento.
                            </label>
                            <strong>Ejemplo de número de referencia:</strong>
                            <img class="img-fluid o_we_custom_image" src="/web/image/472165" 
                                 alt="Ejemplo de número de referencia" loading="lazy"/>
                            <span class="text-dark" style="font-size: 16px; font-weight: 450;">
                                Número de referencia.
                            </span>
                            <input type="text" required="1" name="order" id="order" 
       placeholder="Ej. 1236893898" class="form-control" readonly="1"
       t-att-value="request.httprequest.path.split('/')[-1] if request.httprequest.path.split('/')[-1].isdigit() else ''"/>

                        </div>
                        <br/> <br/>

                        <!-- Monto Total -->
                        <div class="form-group col-12">
                            <em>Ejemplo de dónde encontrar el monto total en su ticket:</em>
                            <img class="img-fluid o_we_custom_image" src="/web/image/472167" 
                                 alt="Ejemplo de monto total en el ticket" loading="lazy"/>
                            <strong>Monto Total* (sin comas ",")</strong>
                            <input type="text" id="amount" required="1" name="amount" 
                                   placeholder="Ej. 840.35" class="form-control"/>
                        </div>
                        <br/>

                        <!-- Botón de Envío -->
                        <div class="clearfix text-center">
                            <a onclick="this.href='/autofacturador/formulario/'+document.getElementById('order').value+'?cantidad='+document.getElementById('amount').value">
                                <button type="button" class="btn btn-primary">Generar factura</button>
                            </a>
                        </div>

                        <!-- Nota importante -->
                        <div class="form-group col-12 mt-4">
                            <div class="s_allow_columns o_container_small">
                                <label class="control-label text-justify">
                                    <em>
                                        Tiene un plazo de <strong>7 días naturales</strong> desde la recepción del producto para generar su factura.
                                        <br/><br/>
                                        <strong><u>Por favor, asegúrese de ingresar sus datos exactamente como aparecen en su cédula fiscal.</u></strong>
                                        <br/><br/>
                                        Si encuentra algún error al generar su factura, capture una imagen del problema y envíela a 
                                        <strong><u>facturacion@score.com.mx</u></strong>.
                                    </em>
                                </label>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="web_address_layout_llantas"
          inherit_id="web.address_layout"
          priority="99">
            <xpath expr="." position="replace">
                <t t-name="web.address_layout">
                    <t t-set="colclass" t-value="('col-sm-5' if report_type == 'html' else 'col-5') + ' ms-auto'"/>
                    <div t-if="address" t-attf-class="address row mb-2" style="font-size:12px !important; line-height:1.3 !important;" title="This block is not always present depending on the printed document.">
                        <t t-if="information_block">
                            <t t-set="colclass" t-value="'col-5 offset-1'"/>
                            <div name="information_block" class="col-6" style="font-size:12px !important; line-height:1.3 !important;">
                                <t t-out="information_block or None">
                                    <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-2 opacity-75 text-muted text-center" style="font-size:12px !important; line-height:1.3 !important;">
                                        <strong>Information block</strong>
                                        <div>Usually contains a source address or a complementary address.</div>
                                    </div>
                                </t>
                            </div>
                        </t>
                        <div name="address" t-att-class="not custom_layout_address and colclass or information_block and colclass" style="font-size:12px !important; line-height:1.3 !important;">
                            <t t-esc="address or None">
                                <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-2 opacity-75 text-muted text-center" style="font-size:12px !important; line-height:1.3 !important;">
                                    <strong>Address block</strong>
                                    <div>Usually contains the address of the document's recipient.</div>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div class="oe_structure" t-else=""/>
                </t>
            </xpath>
        </template>
        <template id="external_layout_boxed_llantas"
          inherit_id="web.external_layout_boxed"
          priority="99">
    
            <xpath expr="//img[@t-att-src]" position="attributes">
                <attribute name="style">max-height:50px !important; height:50px !important; width:auto !important;</attribute>
            </xpath>
            
            <xpath expr="." position="replace">
                <t t-name="web.external_layout_boxed">
                    <div t-attf-class="header o_company_#{company.id}_layout" style="margin-bottom:0 !important; padding-bottom:0 !important;">
                        <div class="row mb8" style="margin-bottom:2px !important;">
                            <div class="col-4">
                                <img t-if="company.logo" class="o_company_logo_big" t-att-src="image_data_uri(company.logo)" alt="Logo" style="max-height:60px !important; height:60px !important; width:auto !important;"/>
                            </div>
                            <div class="col-8 text-end mb4" style="margin-bottom:0 !important; font-size:13px !important; line-height:1.3 !important;">
                                <div name="company_address" class="mb4" style="margin-bottom:0 !important; font-size:13px !important; line-height:1.3 !important;">
                                    <ul class="list-unstyled" name="company_address_list" style="font-size:13px !important; line-height:1.3 !important; margin-bottom:0 !important;">
                                        <li t-if="company.is_company_details_empty" style="font-size:13px !important; line-height:1.3 !important;">
                                            <span t-field="company.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: true}" style="font-size:13px !important; line-height:1.3 !important;">
                                                <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-2 w-100 opacity-75 text-muted text-center" style="font-size:13px !important; line-height:1.3 !important; padding:4px !important;">
                                                    <strong>Company address block</strong>
                                                    <div>Contains the company address.</div>
                                                </div>
                                            </span>
                                        </li>
                                        <li t-else="" style="font-size:13px !important; line-height:1.3 !important;">
                                            <span t-field="company.company_details" style="font-size:13px !important; line-height:1.3 !important;">
                                                <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-2 w-100 opacity-75 text-muted text-center" style="font-size:13px !important; line-height:1.3 !important; padding:4px !important;">
                                                    <strong>Company details block</strong>
                                                    <div>Contains the company details.</div>
                                                </div>
                                            </span>
                                        </li>
                                        <li t-if="not forced_vat" style="font-size:13px !important; line-height:1.3 !important;">
                                            <t t-if="company.vat">
                                                <t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>:
                                                <span t-esc="company.vat" style="font-size:13px !important;">US12345671</span>
                                            </t>
                                        </li>
                                        <li t-else="" style="font-size:13px !important; line-height:1.3 !important;">
                                            <t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>:
                                            <span t-esc="forced_vat" style="font-size:13px !important;">US12345671</span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    <t t-set="layout_background_url" t-value="'data:image/png;base64,%s' % company.layout_background_image.decode('utf-8') if company.layout_background_image and company.layout_background == 'Custom' else '/base/static/img/demo_logo_report.png' if company.layout_background == 'Demo logo' else ''"/>
                    <div t-attf-class="article o_report_layout_boxed o_table_boxed o_company_#{company.id}_layout o_snail_mail {{'o_report_layout_background' if company.layout_background != 'Blank' else ''}}" t-attf-style="{{ 'background-image: url(%s);' % layout_background_url if layout_background_url else '' }}; padding-top:0 !important; margin-top:0 !important;" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
                        <t t-call="web.address_layout"/>
                        <h2 t-out="layout_document_title" style="margin:2px 0 !important; font-size:16px !important;"/>
                        <t t-out="0"/>
                    </div>
                    <div t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}">
                        <div class="o_footer_content" t-attf-class="{{'d-flex' if is_html_empty(company.report_header) else 'row' }} o_footer_content border-top pt-2">
                            <div t-attf-class="{{'flex-grow-1' if is_html_empty(company.report_header) else 'col-8'}} {{'me-2' if is_html_empty(company.report_header) and report_type == 'pdf' else ''}}">
                                <span t-field="company.report_footer"/>
                            </div>
                            <div t-attf-class="{{'' if is_html_empty(company.report_header) else 'col-4'}} text-end">
                                <strong t-if="not is_html_empty(company.report_header)" t-field="company.report_header" class="o_company_tagline">Company tagline</strong>
                                <span t-if="report_type == 'pdf' and display_name_in_footer" class="text-muted" t-out="str(o.name) + ', '">(document name)</span>
                                <span t-if="report_type == 'pdf'" t-attf-class="text-muted {{'text-nowrap' if is_html_empty(company.report_header) else ''}}">Page <span class="page"/> / <span class="topage"/></span>
                            </div>
                        </div>
                    </div>
                </t>
            </xpath>
            
        </template>
        <template id="invoice_llantired" inherit_id="l10n_mx_edi.report_invoice_document" priority="99">
            
            <!-- ====================================================== -->
            <!-- ESTILO GENERAL PARA CENTRADO VERTICAL EN TABLA -->
            <!-- ====================================================== -->
            <xpath expr="//table[@name='invoice_line_table']" position="attributes">
                <attribute name="style">
                    width:100%;
                    font-size:7pt;
                    table-layout:fixed;
                    border-collapse:collapse;
                    border:1px solid #d9d9d9;
                </attribute>
            </xpath>
            
            <!-- ====================================================== -->
            <!-- ESTILOS DE ENCABEZADOS (TODOS CON CENTRADO VERTICAL) -->
            <!-- ====================================================== -->
            
            <!-- SKU (AGREGAR antes de Product code) -->
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_product_unspsc_code']" position="before">
                <th class="text-center" name="th_sku" style="background:#73A07B; color:white; font-size:7pt; font-weight:bold; padding:5px; border:1px solid #5f8a66; text-align:center; vertical-align:middle;">
                    <span>SKU</span>
                </th>
            </xpath>
            
            <!-- Cambiar título de "Product code" a "Código SAT" -->
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_product_unspsc_code']/span" position="replace">
                <span>Código SAT</span>
            </xpath>
            
            <!-- Estilo encabezado Código SAT -->
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_product_unspsc_code']" position="attributes">
                <attribute name="style">background:#73A07B; color:white; font-size:7pt; font-weight:bold; padding:5px; border:1px solid #5f8a66; text-align:center; vertical-align:middle;</attribute>
            </xpath>
            
            <!-- Cambiar título de "Unit code" a "Unidad SAT" -->
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_product_uom_unspsc_code']/span" position="replace">
                <span>Unidad SAT</span>
            </xpath>
            
            <!-- Estilo encabezado Unidad SAT -->
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_product_uom_unspsc_code']" position="attributes">
                <attribute name="style">background:#73A07B; color:white; font-size:7pt; font-weight:bold; padding:5px; border:1px solid #5f8a66; text-align:center; vertical-align:middle;</attribute>
            </xpath>
            
            <!-- Estilo encabezado Descripción -->
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_description']" position="attributes">
                <attribute name="style">background:#73A07B; color:white; font-size:7pt; font-weight:bold; padding:5px; border:1px solid #5f8a66; text-align:center; vertical-align:middle;</attribute>
            </xpath>
            
            <!-- Estilo encabezado Cantidad -->
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_quantity']" position="attributes">
                <attribute name="style">background:#73A07B; color:white; font-size:7pt; font-weight:bold; padding:5px; border:1px solid #5f8a66; text-align:center; vertical-align:middle;</attribute>
            </xpath>
            
            <!-- Estilo encabezado Precio -->
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_priceunit']" position="attributes">
                <attribute name="style">background:#73A07B; color:white; font-size:7pt; font-weight:bold; padding:5px; border:1px solid #5f8a66; text-align:center; vertical-align:middle;</attribute>
            </xpath>
            
            <!-- Estilo encabezado Descuento -->
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_discount']" position="attributes">
                <attribute name="style">background:#73A07B; color:white; font-size:7pt; font-weight:bold; padding:5px; border:1px solid #5f8a66; text-align:center; vertical-align:middle;</attribute>
            </xpath>
            
            <!-- Estilo encabezado Impuestos -->
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_taxes']" position="attributes">
                <attribute name="style">background:#73A07B; color:white; font-size:7pt; font-weight:bold; padding:5px; border:1px solid #5f8a66; text-align:center; vertical-align:middle;</attribute>
            </xpath>
            
            <!-- Estilo encabezado Subtotal -->
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_subtotal']" position="attributes">
                <attribute name="style">background:#73A07B; color:white; font-size:7pt; font-weight:bold; padding:5px; border:1px solid #5f8a66; text-align:center; vertical-align:middle;</attribute>
            </xpath>
            
            <!-- ====================================================== -->
            <!-- CELDAS DE DATOS (CENTRADO VERTICAL) -->
            <!-- ====================================================== -->
            
            <!-- SKU -->
            <xpath expr="//table[@name='invoice_line_table']//td[@name='td_product_unspsc_code']" position="before">
                <td name="td_sku" class="text-center" style="background:#f8f8f8; font-size:7pt; padding:4px; border-bottom:1px solid #e5e5e5; vertical-align:middle; width:10%;">
                    <span t-field="line.product_id.default_code"/>
                </td>
            </xpath>
            
            <!-- Código SAT -->
            <xpath expr="//table[@name='invoice_line_table']//td[@name='td_product_unspsc_code']" position="attributes">
                <attribute name="style">background:#f8f8f8; font-size:7pt; padding:4px; border-bottom:1px solid #e5e5e5; vertical-align:middle; text-align:center; width:12%;</attribute>
            </xpath>
            
            <!-- Unidad SAT -->
            <xpath expr="//table[@name='invoice_line_table']//td[@name='td_product_uom_unspsc_code']" position="attributes">
                <attribute name="style">background:#f8f8f8; font-size:7pt; padding:4px; border-bottom:1px solid #e5e5e5; vertical-align:middle; text-align:center; width:10%;</attribute>
            </xpath>
            
            <!-- Descripción -->
            <xpath expr="//table[@name='invoice_line_table']//td[@name='account_invoice_line_name']" position="attributes">
                <attribute name="style">font-weight:500; font-size:7pt; padding:4px; border-bottom:1px solid #e5e5e5; vertical-align:middle; text-align:left;</attribute>
            </xpath>
            
            <!-- Cantidad + Unidad comercial -->
            <xpath expr="//table[@name='invoice_line_table']//td[@name='td_quantity']" position="replace">
                <td name="td_quantity" class="text-center" style="font-size:7pt; padding:4px; border-bottom:1px solid #e5e5e5; vertical-align:middle;">
                    <span t-field="line.quantity"/>
                    <span> </span>
                    <span t-field="line.product_uom_id.name"/>
                 </td>
            </xpath>
            
            <!-- Precio Unitario (SIN IVA) -->
            <xpath expr="//table[@name='invoice_line_table']//td[@name='td_price_unit']" position="replace">
                <td name="td_price_unit" class="text-end" style="font-size:7pt; padding:4px; border-bottom:1px solid #e5e5e5; vertical-align:middle;">
                    <span t-if="not hide_prices">
                        <t t-set="tax_rate" t-value="0.0"/>
                        <t t-foreach="line.tax_ids" t-as="tax">
                            <t t-if="tax.amount_type == 'percent'">
                                <t t-set="tax_rate" t-value="tax_rate + tax.amount"/>
                            </t>
                        </t>
                        <t t-set="price_without_tax" t-value="line.price_unit / (1 + (tax_rate / 100)) if tax_rate else line.price_unit"/>
                        <t t-esc="'{:,.2f}'.format(price_without_tax)"/>
                    </span>
                </td>
            </xpath>
            
            <!-- Subtotal (SIN IVA) -->
            <xpath expr="//table[@name='invoice_line_table']//td[@name='td_subtotal']" position="replace">
                <td name="td_subtotal" class="text-end" style="font-size:7pt; padding:4px; border-bottom:1px solid #e5e5e5; vertical-align:middle;">
                    <span t-if="not hide_prices">
                        <t t-set="tax_rate" t-value="0.0"/>
                        <t t-foreach="line.tax_ids" t-as="tax">
                            <t t-if="tax.amount_type == 'percent'">
                                <t t-set="tax_rate" t-value="tax_rate + tax.amount"/>
                            </t>
                        </t>
                        <t t-set="price_without_tax" t-value="line.price_unit / (1 + (tax_rate / 100)) if tax_rate else line.price_unit"/>
                        <t t-set="subtotal_without_tax" t-value="price_without_tax * line.quantity"/>
                        <t t-esc="'{:,.2f}'.format(subtotal_without_tax)"/>
                    </span>
                </td>
            </xpath>
            
            <!-- Cambiar texto del encabezado Precio -->
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_priceunit']/span" position="replace">
                <span>Precio SIN IVA</span>
            </xpath>
            
            <!-- ====================================================== -->
            <!-- SECCIÓN DE INFORMACIÓN (Fecha, Origen, etc) TAMAÑO 12px -->
            <!-- ====================================================== -->
            <xpath expr="//div[@id='informations']" position="attributes">
                <attribute name="style">font-size:12px !important; line-height:1.4; margin-bottom:10px;</attribute>
            </xpath>
            
            <!-- ====================================================== -->
            <!-- MONEDA DENTRO DE INFORMACIONES -->
            <!-- ====================================================== -->
            <xpath expr="//div[@id='informations']" position="inside">
                <div class="col" style="font-size:12px;">
                    <strong>Moneda:</strong>
                    <span t-esc="o.currency_id.name"/>
                </div>
            </xpath>
            
            <!-- ====================================================== -->
            <!-- TIPO DE CAMBIO -->
            <!-- ====================================================== -->
            <xpath expr="//div[@id='informations']" position="after">
                <div class="row mb-2" t-if="o.currency_id.name == 'USD'" style="font-size:12px;">
                    <div class="col">
                        <strong>Tipo de Cambio:</strong>
                        <span t-esc="'%.6f' % (o.exchange_rate or 0.0)"/>
                    </div>
                </div>
            </xpath>
            
            <!-- ====================================================== -->
            <!-- SECCIÓN DE TOTALES - SOLO ESTILO DEL CONTENEDOR -->
            <!-- ====================================================== -->
            <xpath expr="//div[@id='total']" position="attributes">
                <attribute name="style">font-size:7pt !important; line-height:1.2; margin-top:5px;</attribute>
            </xpath>
            
            <!-- ====================================================== -->
            <!-- DATOS BANCARIOS -->
            <!-- ====================================================== -->
            <xpath expr="//div[@id='total']" position="after">
                <div class="row mt-2" style="width:100%; font-size:8pt;">
                    <div class="col-12">
                        <div t-if="o.move_type == 'out_invoice' and o.state == 'posted'"
                             style="border:1px solid #d9d9d9; margin-bottom:6px;">
                            <div style="background:#73A07B; color:white; padding:4px 6px; font-weight:bold; font-size:8pt;">
                                DATOS PARA TRANSFERENCIA BANCARIA
                            </div>
                            <table style="width:100%; font-size:7pt; border-collapse:collapse;">
                                <tbody>
                                    <tr>
                                        <td style="padding:2px 4px; width:28%;"><strong>BANCO:</strong></td>
                                        <td style="padding:2px 4px;">
                                            <t t-if="o.currency_id.name == 'USD'">BANORTE (DÓLARES)</t>
                                            <t t-else="">HSBC</t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:2px 4px;"><strong>CONCEPTO:</strong></td>
                                        <td style="padding:2px 4px;">
                                            <span t-field="o.payment_reference" t-options="{'widget': 'text'}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:2px 4px;"><strong>CLABE:</strong></td>
                                        <td style="padding:2px 4px;">
                                            <t t-if="o.company_id.name == 'LLANTIRED' and o.currency_id.name == 'MXN'">
                                                021743040678913582
                                            </t>
                                            <t t-elif="o.company_id.name == 'LLANTIRED' and o.currency_id.name == 'USD'">
                                                072731013015735748
                                            </t>
                                            <t t-elif="o.company_id.name == 'LA BODEGA LLANTAS Y ACCESORIOS' and o.currency_id.name == 'MXN'">
                                                021743040189731499
                                            </t>
                                            <t t-elif="o.company_id.name == 'LA BODEGA LLANTAS Y ACCESORIOS' and o.currency_id.name == 'USD'">
                                                021743070004580915
                                            </t>
                                            <t t-elif="o.company_id.name == 'A-DRONE'">
                                                072731011952302184
                                            </t>
                                            <t t-else="">
                                                <span t-field="o.company_id.bank_ids.acc_number"/>
                                            </t>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </xpath>
            
            <!-- ====================================================== -->
            <!-- COMPACTAR ESTILOS GENERALES -->
            <!-- ====================================================== -->
            <xpath expr="//div[@name='comment']" position="attributes">
                <attribute name="style">font-size:8pt !important; line-height:1.2 !important; margin-bottom:2px !important; text-align:justify;</attribute>
            </xpath>
            
        </template>
    </data>
</odoo>